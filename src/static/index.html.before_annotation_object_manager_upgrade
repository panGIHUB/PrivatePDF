<script id="upgrade-8-pdf-inspector-js">

(function(){

    function pp8Esc(value){
        return String(value ?? "")
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");
    }

    function pp8$(id){
        return document.getElementById(id);
    }

    function pp8Open(){
        const el = pp8$("pp8Inspector");
        if(el) el.classList.remove("hidden");

        const file = pp8$("pp8File");
        if(file) file.value = "";

        const content = pp8$("pp8Content");
        if(content){
            content.innerHTML =
                '<div class="pp8-loading">Select a PDF to see its technical profile.</div>';
        }

        const label = pp8$("pp8FileLabel");
        if(label) label.textContent = "Choose a PDF to inspect";
    }

    function pp8Close(){
        const el = pp8$("pp8Inspector");
        if(el) el.classList.add("hidden");
    }

    async function pp8Inspect(){

        const input = pp8$("pp8File");
        const file = input && input.files ? input.files[0] : null;

        if(!file) return;

        if(!file.name.toLowerCase().endsWith(".pdf")){
            pp8$("pp8Content").innerHTML =
                '<div class="pp8-error">Please select a PDF file.</div>';
            return;
        }

        pp8$("pp8FileLabel").textContent =
            file.name + " • " +
            (file.size / (1024 * 1024)).toFixed(2) + " MB";

        pp8$("pp8Content").innerHTML =
            '<div class="pp8-loading">Inspecting PDF locally...</div>';

        const fd = new FormData();
        fd.append("file", file);

        try{

            const response = await fetch("/api/pdf-inspect",{
                method:"POST",
                body:fd
            });

            let data = null;

            try{
                data = await response.json();
            }catch(e){
                throw new Error("Invalid server response.");
            }

            if(!response.ok || !data.ok){
                throw new Error(data.error || "Unable to inspect PDF.");
            }

            const securityClass = data.encrypted ? "warn" : "ok";

            let metaHtml = "";

            const metaKeys = Object.keys(data.metadata || {});

            if(metaKeys.length){

                metaHtml = metaKeys.map(function(key){

                    return `
                        <div class="pp8-meta-item">
                            <span>${pp8Esc(key)}</span>
                            <span>${pp8Esc(data.metadata[key])}</span>
                        </div>
                    `;

                }).join("");

            }else{

                metaHtml =
                    '<div class="pp8-loading" style="padding:12px 0;">No document metadata found.</div>';

            }

            pp8$("pp8Content").innerHTML = `

                <div class="pp8-grid">

                    <div class="pp8-stat">
                        <span>File size</span>
                        <strong>${pp8Esc(data.size_label)}</strong>
                    </div>

                    <div class="pp8-stat">
                        <span>Pages</span>
                        <strong>${pp8Esc(data.page_count)}</strong>
                    </div>

                    <div class="pp8-stat">
                        <span>PDF version</span>
                        <strong>${pp8Esc(data.pdf_version)}</strong>
                    </div>

                    <div class="pp8-stat">
                        <span>Average page</span>
                        <strong>${pp8Esc(data.average_page_kb)} KB</strong>
                    </div>

                </div>

                <div class="pp8-status ${securityClass}">
                    <strong>
                        ${data.encrypted
                            ? "🔐 PDF is encrypted/protected"
                            : "✓ PDF is not encrypted"}
                    </strong>

                    <span>
                        ${data.encrypted
                            ? "Some operations may require the document password."
                            : "The PDF is available for normal processing."}
                    </span>
                </div>

                <div class="pp8-columns">

                    <div class="pp8-panel">

                        <h3>Document profile</h3>

                        <div class="pp8-row">
                            <span>Text pages</span>
                            <strong>${pp8Esc(data.text_pages)}</strong>
                        </div>

                        <div class="pp8-row">
                            <span>Image pages</span>
                            <strong>${pp8Esc(data.image_pages)}</strong>
                        </div>

                        <div class="pp8-row">
                            <span>Portrait pages</span>
                            <strong>${pp8Esc(data.portrait_pages)}</strong>
                        </div>

                        <div class="pp8-row">
                            <span>Landscape pages</span>
                            <strong>${pp8Esc(data.landscape_pages)}</strong>
                        </div>

                        <div class="pp8-row">
                            <span>Square pages</span>
                            <strong>${pp8Esc(data.square_pages)}</strong>
                        </div>

                    </div>

                    <div class="pp8-panel">

                        <h3>Document metadata</h3>

                        <div class="pp8-meta">
                            ${metaHtml}
                        </div>

                    </div>

                </div>

            `;

        }catch(error){

            pp8$("pp8Content").innerHTML =
                '<div class="pp8-error">' +
                pp8Esc(error.message || "Inspection failed.") +
                '</div>';

        }
    }

    function pp8InstallDashboardButton(){

        if(document.getElementById("pp8DashboardInspectorButton"))
            return;

        const dashboard =
            document.getElementById("pp7Dashboard");

        if(!dashboard)
            return;

        const actions =
            dashboard.querySelector(".pp7-actions");

        if(actions){

            const button =
                document.createElement("button");

            button.type = "button";
            button.id = "pp8DashboardInspectorButton";
            button.className = "pp7-action";
            button.innerHTML =
                "<span>🔎</span><strong>PDF Inspector</strong>" +
                "<small>Check file details</small>";

            button.onclick = pp8Open;

            actions.appendChild(button);
        }
    }

    function pp8InstallTool(){

        if(document.getElementById("pp8ToolButton"))
            return;

        const nav =
            document.querySelector(".nav");

        if(!nav)
            return;

        const button =
            document.createElement("button");

        button.type = "button";
        button.id = "pp8ToolButton";
        button.innerHTML =
            "🔎 <span>PDF Inspector</span>";

        button.onclick = pp8Open;

        nav.appendChild(button);
    }

    window.PP8Inspector = {
        open: pp8Open,
        close: pp8Close,
        inspect: pp8Inspect
    };

    document.addEventListener("DOMContentLoaded",function(){

        pp8InstallDashboardButton();
        pp8InstallTool();

        const overlay = pp8$("pp8Inspector");

        if(overlay){

            overlay.addEventListener("click",function(event){

                if(event.target === overlay)
                    pp8Close();

            });

        }

        document.addEventListener("keydown",function(event){

            if(event.key === "Escape"){
                pp8Close();
            }

        });

        setTimeout(function(){
            pp8InstallDashboardButton();
            pp8InstallTool();
        },700);

        setTimeout(function(){
            pp8InstallDashboardButton();
            pp8InstallTool();
        },1800);

    });

})();

</script>


