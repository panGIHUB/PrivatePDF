<script id="advanced-smart-queue-js">

window.PPQueue = {

  files: [],

  formatBytes(bytes){
    if(!bytes) return "0 B";

    const units=["B","KB","MB","GB"];
    const i=Math.floor(Math.log(bytes)/Math.log(1024));

    return (
      bytes / Math.pow(1024,i)
    ).toFixed(i ? 1 : 0) + " " + units[i];
  },

  isDuplicate(file){
    return this.files.some(x =>
      x.name === file.name &&
      x.size === file.size &&
      x.lastModified === file.lastModified
    );
  },

  receive(fileList){

    const incoming=[...fileList];

    incoming.forEach(file=>{
      if(!this.isDuplicate(file)){
        this.files.push(file);
      }
    });

    this.render();
  },

  addMore(){
    const input=document.getElementById("ppQueueInput");
    if(input) input.click();
  },

  openPicker(){
    this.addMore();
  },

  dragOver(event){
    event.preventDefault();

    const zone=document.getElementById("ppQueueDrop");

    if(zone){
      zone.classList.add("dragover");
    }
  },

  dragLeave(event){
    event.preventDefault();

    const zone=document.getElementById("ppQueueDrop");

    if(zone){
      zone.classList.remove("dragover");
    }
  },

  drop(event){
    event.preventDefault();

    const zone=document.getElementById("ppQueueDrop");

    if(zone){
      zone.classList.remove("dragover");
    }

    if(event.dataTransfer?.files?.length){
      this.receive(event.dataTransfer.files);
    }
  },

  remove(index){

    if(index < 0 || index >= this.files.length){
      return;
    }

    this.files.splice(index,1);

    this.render();
  },

  clear(){

    this.files=[];

    this.render();
  },

  show(){

    const box=document.getElementById("ppSmartQueue");

    if(box){
      box.classList.remove("hidden");
    }

    this.render();
  },

  render(){

    const box=document.getElementById("ppSmartQueue");
    const items=document.getElementById("ppQueueItems");
    const summary=document.getElementById("ppQueueSummary");
    const size=document.getElementById("ppQueueSize");

    if(!box || !items){
      return;
    }

    if(!this.files.length){

      box.classList.add("hidden");

      items.innerHTML="";

      if(summary) summary.textContent="0 files";
      if(size) size.textContent="0 B";

      return;
    }

    box.classList.remove("hidden");

    items.innerHTML="";

    let total=0;

    this.files.forEach((file,index)=>{

      total += file.size;

      const row=document.createElement("div");
      row.className="pp-queue-item";

      const number=document.createElement("div");
      number.className="pp-queue-number";
      number.textContent=index+1;

      const thumb=document.createElement("div");
      thumb.className="pp-queue-thumb";

      if(file.type.startsWith("image/")){

        const img=document.createElement("img");

        img.src=URL.createObjectURL(file);

        thumb.appendChild(img);

      }else{

        thumb.textContent =
          file.type==="application/pdf" ||
          file.name.toLowerCase().endsWith(".pdf")
          ? "📄"
          : "📁";
      }

      const info=document.createElement("div");
      info.className="pp-queue-info";

      const name=document.createElement("div");
      name.className="pp-queue-name";
      name.title=file.name;
      name.textContent=file.name;

      const meta=document.createElement("div");
      meta.className="pp-queue-meta";

      meta.textContent =
        this.formatBytes(file.size) +
        " • " +
        (file.type || "unknown");

      info.appendChild(name);
      info.appendChild(meta);

      const remove=document.createElement("button");
      remove.type="button";
      remove.className="pp-queue-remove";
      remove.title="Remove";
      remove.textContent="✕";

      remove.onclick=()=>{
        this.remove(index);
      };

      row.appendChild(number);
      row.appendChild(thumb);
      row.appendChild(info);
      row.appendChild(remove);

      items.appendChild(row);
    });

    if(summary){
      summary.textContent =
        this.files.length +
        (this.files.length===1 ? " file" : " files");
    }

    if(size){
      size.textContent=this.formatBytes(total);
    }
  }
};

</script>


