<script id="upgrade-9-job-center-js">

(function(){

    "use strict";

    const originalFetch = window.fetch;

    let activeJob = null;
    let elapsedTimer = null;
    let hideTimer = null;

    function $(id){
        return document.getElementById(id);
    }

    function esc(value){
        return String(value ?? "")
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");
    }

    function formatBytes(bytes){

        if(!Number.isFinite(bytes) || bytes <= 0)
            return "—";

        if(bytes < 1024)
            return bytes + " B";

        if(bytes < 1024 * 1024)
            return (bytes / 1024).toFixed(1) + " KB";

        if(bytes < 1024 * 1024 * 1024)
            return (bytes / (1024 * 1024)).toFixed(2) + " MB";

        return (bytes / (1024 * 1024 * 1024)).toFixed(2) + " GB";
    }

    function operationName(url){

        const map = {
            "/api/merge":"Merge PDF",
            "/api/pages":"Page operation",
            "/api/rotate":"Rotate PDF",
            "/api/compress":"Compress PDF",
            "/api/resize":"Resize PDF",
            "/api/crop":"Crop PDF",
            "/api/numbers":"Add page numbers",
            "/api/watermark":"Watermark PDF",
            "/api/protect":"Protect PDF",
            "/api/unlock":"Unlock PDF",
            "/api/metadata":"Process metadata",
            "/api/grayscale":"Grayscale PDF",
            "/api/text":"Extract text",
            "/api/markdown":"Create Markdown",
            "/api/pdf-to-jpg":"PDF to JPG",
            "/api/images-to-pdf":"Images to PDF",
            "/api/office-to-pdf":"Office to PDF",
            "/api/pdf-to-office":"PDF conversion",
            "/api/image-resize":"Image resize",
            "/api/page-thumbnails":"Generate page thumbnails",
            "/api/rotate-pages":"Rotate selected pages",
            "/api/batch-process":"Batch processing",
            "/api/pdf-inspect":"Inspect PDF"
        };

        return map[url] || "PDF operation";
    }

    function getFilename(options){

        try{

            if(options && options.body instanceof FormData){

                const entries = options.body.entries();

                for(const item of entries){

                    const value = item[1];

                    if(value instanceof File){

                        return value.name || "Document";
                    }
                }
            }

        }catch(error){}

        return "Document";
    }

    function show(options, url){

        const center = $("pp9JobCenter");

        if(!center)
            return;

        if(hideTimer){
            clearTimeout(hideTimer);
            hideTimer = null;
        }

        const filename = getFilename(options);
        const operation = operationName(url);

        activeJob = {
            started:performance.now(),
            filename:filename,
            operation:operation
        };

        $("pp9JobTitle").textContent = operation;
        $("pp9JobSubtitle").textContent =
            "Processing temporarily on this device";

        $("pp9JobFile").textContent = filename;
        $("pp9JobOperation").textContent = operation;

        $("pp9JobIcon").textContent = "⚙️";

        $("pp9JobProgressLabel").textContent = "Processing";
        $("pp9JobProgressValue").textContent = "Working...";

        $("pp9JobProgress").classList.add("indeterminate");
        $("pp9JobProgressBar").style.width = "38%";

        $("pp9Elapsed").textContent = "0s";
        $("pp9JobSize").textContent = "—";
        $("pp9JobState").textContent = "Running";

        $("pp9JobStatus").className =
            "pp9-job-status processing";

        $("pp9JobStatus").innerHTML =
            '<span class="pp9-status-dot pulse"></span>' +
            '<span id="pp9JobStatusText">' +
            'Processing securely...' +
            '</span>';

        $("pp9JobActions").style.display = "none";

        center.classList.remove("hidden");

        if(elapsedTimer)
            clearInterval(elapsedTimer);

        elapsedTimer = setInterval(function(){

            if(!activeJob)
                return;

            const seconds =
                Math.max(
                    0,
                    Math.floor(
                        (performance.now() - activeJob.started) / 1000
                    )
                );

            const el = $("pp9Elapsed");

            if(el)
                el.textContent = seconds + "s";

        },250);

    }

    function success(response){

        if(!activeJob)
            return;

        if(elapsedTimer){
            clearInterval(elapsedTimer);
            elapsedTimer = null;
        }

        const elapsed =
            Math.max(
                0,
                Math.round(
                    (performance.now() - activeJob.started) / 100
                ) / 10
            );

        const center = $("pp9JobCenter");

        if(!center)
            return;

        $("pp9JobTitle").textContent =
            "Processing complete";

        $("pp9JobSubtitle").textContent =
            "Your result is ready";

        $("pp9JobIcon").textContent = "✓";

        $("pp9JobProgress").classList.remove("indeterminate");
        $("pp9JobProgressBar").style.width = "100%";

        $("pp9JobProgressLabel").textContent =
            "Complete";

        $("pp9JobProgressValue").textContent =
            "100%";

        $("pp9Elapsed").textContent =
            elapsed + "s";

        $("pp9JobState").textContent =
            "Complete";

        $("pp9JobStatus").className =
            "pp9-job-status success";

        $("pp9JobStatus").innerHTML =
            '<span class="pp9-status-dot"></span>' +
            '<span>Result generated successfully.</span>';

        $("pp9JobActions").style.display = "flex";

        try{

            const length = response.headers.get("content-length");

            if(length)
                $("pp9JobSize").textContent =
                    formatBytes(Number(length));

        }catch(error){}

        hideTimer = setTimeout(function(){

            if(center)
                center.classList.add("hidden");

        },7000);

    }

    function failure(error){

        if(elapsedTimer){
            clearInterval(elapsedTimer);
            elapsedTimer = null;
        }

        const center = $("pp9JobCenter");

        if(!center)
            return;

        $("pp9JobTitle").textContent =
            "Processing failed";

        $("pp9JobSubtitle").textContent =
            "The operation could not be completed";

        $("pp9JobIcon").textContent = "!";

        $("pp9JobProgress").classList.remove("indeterminate");
        $("pp9JobProgressBar").style.width = "100%";

        $("pp9JobProgressLabel").textContent =
            "Failed";

        $("pp9JobProgressValue").textContent =
            "Error";

        $("pp9JobState").textContent =
            "Failed";

        $("pp9JobStatus").className =
            "pp9-job-status error";

        $("pp9JobStatus").innerHTML =
            '<span class="pp9-status-dot"></span>' +
            '<span>' +
            esc(
                error && error.message
                    ? error.message
                    : "Operation failed."
            ) +
            '</span>';

        $("pp9JobActions").style.display = "flex";

    }

    function close(){

        const center = $("pp9JobCenter");

        if(center)
            center.classList.add("hidden");

        if(elapsedTimer){
            clearInterval(elapsedTimer);
            elapsedTimer = null;
        }

        if(hideTimer){
            clearTimeout(hideTimer);
            hideTimer = null;
        }

        activeJob = null;
    }

    window.PP9Job = {
        open:function(){
            const center = $("pp9JobCenter");
            if(center) center.classList.remove("hidden");
        },
        close:close
    };

    /*
     * Global fetch monitor.
     *
     * Only watches local API requests.
     * Static files and external resources are ignored.
     */
    window.fetch = async function(input, init){

        let url = "";

        try{

            if(typeof input === "string"){
                url = input;
            }else if(input && input.url){
                url = input.url;
            }

        }catch(error){}

        const isApi =
            typeof url === "string" &&
            url.indexOf("/api/") === 0;

        if(!isApi)
            return originalFetch.apply(this, arguments);

        show(init || {}, url);

        try{

            const response =
                await originalFetch.apply(this, arguments);

            if(response.ok){

                success(response);

            }else{

                let message =
                    "Server returned HTTP " +
                    response.status;

                try{

                    const clone = response.clone();
                    const data = await clone.json();

                    if(data && data.error)
                        message = data.error;

                }catch(error){}

                failure(new Error(message));
            }

            return response;

        }catch(error){

            failure(error);
            throw error;

        }

    };

    document.addEventListener("DOMContentLoaded",function(){

        const center = $("pp9JobCenter");

        if(center){

            center.addEventListener(
                "click",
                function(event){

                    if(event.target === center)
                        close();

                }
            );

        }

    });

})();

</script>


