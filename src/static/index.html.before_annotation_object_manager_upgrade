<script id="upgrade-11-pdf-editing-workspace-js">

(function(){

    "use strict";

    const state = {
        file:null,
        pages:[],
        current:0,
        selected:new Set(),
        previewRotation:0,
        cropPreview:0,
        watermarkPosition:"center"
    };

    function $(id){
        return document.getElementById(id);
    }

    function escapeHTML(value){

        return String(value ?? "")
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");

    }

    function status(message){

        if(typeof window.st === "function")
            window.st(message);
        else
            console.log(message);

    }

    function parseRange(spec,total){

        const result = new Set();

        if(!spec)
            return result;

        spec.split(",").forEach(function(part){

            part = part.trim();

            if(!part)
                return;

            if(part.includes("-")){

                const parts =
                    part.split("-")
                        .map(function(v){
                            return parseInt(v.trim(),10);
                        });

                const a = parts[0];
                const b = parts[1];

                if(
                    Number.isFinite(a) &&
                    Number.isFinite(b)
                ){

                    const start =
                        Math.max(1,Math.min(a,b));

                    const end =
                        Math.min(total,Math.max(a,b));

                    for(
                        let i=start;
                        i<=end;
                        i++
                    ){
                        result.add(i);
                    }

                }

            }else{

                const n =
                    parseInt(part,10);

                if(
                    Number.isFinite(n) &&
                    n >= 1 &&
                    n <= total
                ){

                    result.add(n);

                }

            }

        });

        return result;

    }

    function updateSelectionUI(){

        const count =
            state.selected.size;

        const label =
            $("pp11SelectedLabel");

        if(label)
            label.textContent =
                count + " selected";

        document
            .querySelectorAll(".pp11-page-item")
            .forEach(function(item){

                const n =
                    Number(item.dataset.page);

                item.classList.toggle(
                    "selected",
                    state.selected.has(n)
                );

            });

    }

    function renderPageList(){

        const box =
            $("pp11PageList");

        if(!box)
            return;

        if(!state.pages.length){

            box.innerHTML =
                '<div style="padding:14px;text-align:center;color:#929bb0;font-size:9px;">' +
                'No page previews yet.' +
                '</div>';

            return;

        }

        box.innerHTML =
            state.pages.map(function(page,index){

                const n = index + 1;

                return `
                    <div
                        class="pp11-page-item"
                        data-page="${n}">

                        <img
                            class="pp11-page-thumb"
                            src="${escapeHTML(page.image)}"
                            alt="Page ${n}">

                        <div class="pp11-page-meta">

                            <strong>
                                Page ${n}
                            </strong>

                            <span>
                                ${escapeHTML(page.orientation || "PDF page")}
                            </span>

                        </div>

                    </div>
                `;

            }).join("");

        box.querySelectorAll(".pp11-page-item")
            .forEach(function(item){

                item.addEventListener(
                    "click",
                    function(){

                        const n =
                            Number(item.dataset.page);

                        state.current = n - 1;

                        if(state.selected.has(n))
                            state.selected.delete(n);
                        else
                            state.selected.add(n);

                        renderCurrentPage();
                        updateSelectionUI();

                    }
                );

            });

        updateSelectionUI();

    }

    function renderCurrentPage(){

        const canvas =
            $("pp11Canvas");

        const counter =
            $("pp11PageCounter");

        if(!canvas)
            return;

        if(!state.pages.length){

            canvas.innerHTML = `
                <div class="pp11-page">
                    <div class="pp11-page-empty">
                        <strong>Select a PDF to begin</strong>
                        <span>Page previews will appear here</span>
                    </div>
                </div>
            `;

            if(counter)
                counter.textContent =
                    "Page 0 / 0";

            return;

        }

        const page =
            state.pages[state.current];

        if(!page)
            return;

        const rotation =
            ((state.previewRotation % 360) + 360) % 360;

        canvas.innerHTML = `
            <div
                class="pp11-page"
                id="pp11PreviewPage"
                style="transform:rotate(${rotation}deg);">

                <img
                    class="pp11-page-image"
                    src="${escapeHTML(page.image)}"
                    alt="PDF page">

                <div
                    id="pp11WatermarkPreview"
                    class="pp11-watermark-preview">
                </div>

            </div>
        `;

        if(counter)
            counter.textContent =
                "Page " +
                (state.current + 1) +
                " / " +
                state.pages.length;

        applyCropPreview();
        updateWatermarkPreview();

    }

    async function load(){

        const input =
            $("pp11SourceFile");

        if(!input || !input.files.length){

            status("Select a PDF first.");
            return;

        }

        const file =
            input.files[0];

        state.file = file;
        state.pages = [];
        state.current = 0;
        state.selected.clear();

        const name =
            $("pp11SourceName");

        if(name)
            name.textContent = file.name;

        renderCurrentPage();
        renderPageList();

        try{

            const fd = new FormData();

            fd.append("file",file);

            fd.append("max_pages","40");
            fd.append("width","720");
            fd.append("quality","78");

            const response =
                await fetch(
                    "/api/page-thumbnails",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            if(!response.ok)
                throw new Error(
                    "Thumbnail generation failed."
                );

            const data =
                await response.json();

            state.pages =
                Array.isArray(data.thumbnails)
                    ? data.thumbnails
                    : [];

            state.selected.clear();

            renderPageList();
            renderCurrentPage();

            if(!state.pages.length){

                status(
                    "No page previews were returned."
                );

            }else{

                status(
                    state.pages.length +
                    " page preview(s) loaded."
                );

            }

        }catch(error){

            console.error(error);

            status(
                error.message ||
                "Unable to load PDF previews."
            );

        }

    }

    function selectAll(){

        state.selected.clear();

        for(
            let i=1;
            i<=state.pages.length;
            i++
        ){

            state.selected.add(i);

        }

        updateSelectionUI();

    }

    function clearSelection(){

        state.selected.clear();
        updateSelectionUI();

    }

    function selectRange(){

        const spec =
            $("pp11PageRange").value;

        if(!spec){

            status(
                "Enter a page range first."
            );

            return;

        }

        state.selected =
            parseRange(
                spec,
                state.pages.length
            );

        updateSelectionUI();

    }

    function selectedSpec(){

        const values =
            [...state.selected]
                .sort(function(a,b){return a-b;});

        if(!values.length)
            return "";

        const ranges = [];
        let start = values[0];
        let previous = values[0];

        for(
            let i=1;
            i<values.length;
            i++
        ){

            const current = values[i];

            if(current === previous + 1){

                previous = current;

            }else{

                ranges.push(
                    start === previous
                        ? String(start)
                        : start + "-" + previous
                );

                start = current;
                previous = current;

            }

        }

        ranges.push(
            start === previous
                ? String(start)
                : start + "-" + previous
        );

        return ranges.join(",");

    }

    function rotatePreview(degrees){

        state.previewRotation += degrees;

        renderCurrentPage();

    }

    function rotateSelected(degrees){

        if(!state.file){

            status("Select a PDF first.");
            return;

        }

        const spec =
            selectedSpec();

        if(!spec){

            status(
                "Select one or more pages first."
            );

            return;

        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("pages",spec);
        fd.append("degrees",String(degrees));

        fetch(
            "/api/rotate-pages",
            {
                method:"POST",
                body:fd
            }
        ).then(async function(response){

            if(!response.ok){

                let message =
                    "Rotation failed.";

                try{

                    const data =
                        await response.json();

                    if(data.error)
                        message = data.error;

                }catch(error){}

                throw new Error(message);

            }

            return response.blob();

        }).then(function(blob){

            downloadBlob(
                blob,
                "Rotated_Selected_Pages.pdf"
            );

            status(
                "Selected pages rotated."
            );

        }).catch(function(error){

            status(
                error.message ||
                "Rotation failed."
            );

        });

    }

    function applyResize(){

        if(!state.file){

            status("Select a PDF first.");
            return;

        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append(
            "size",
            $("pp11Paper").value
        );

        fd.append(
            "orientation",
            $("pp11Orientation").value
        );

        if(
            typeof window.send === "function"
        ){

            window.send(
                "/api/resize",
                fd,
                "Resized_Layout.pdf"
            );

        }else{

            status(
                "Resize engine unavailable."
            );

        }

    }

    function previewCrop(){

        state.cropPreview =
            Number(
                $("pp11CropMargin").value || 0
            );

        applyCropPreview();

        status(
            "Crop preview updated."
        );

    }

    function applyCropPreview(){

        const page =
            $("pp11PreviewPage");

        if(!page)
            return;

        const margin =
            Math.max(0,state.cropPreview);

        if(!margin){

            page.style.clipPath =
                "none";

            return;

        }

        const px =
            Math.min(
                18,
                margin / 4
            );

        page.style.clipPath =
            "inset(" +
            px +
            "px " +
            px +
            "px " +
            px +
            "px)";

    }

    function applyCrop(){

        if(!state.file){

            status("Select a PDF first.");
            return;

        }

        const margin =
            $("pp11CropMargin").value;

        if(
            typeof window.send !== "function"
        ){

            status(
                "Crop engine unavailable."
            );

            return;

        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("margin",margin);

        window.send(
            "/api/crop",
            fd,
            "Cropped.pdf"
        );

    }

    function applyNumbers(){

        if(!state.file){

            status("Select a PDF first.");
            return;

        }

        const fd = new FormData();

        fd.append(
            "file",
            state.file
        );

        fd.append(
            "start",
            $("pp11NumberStart").value
        );

        if(typeof window.send === "function"){

            window.send(
                "/api/numbers",
                fd,
                "Numbered.pdf"
            );

        }

    }

    function positionWatermark(element){

        const pos =
            state.watermarkPosition;

        element.style.left = "";
        element.style.right = "";
        element.style.top = "";
        element.style.bottom = "";
        element.style.transform =
            "translate(-50%,-50%)";

        if(pos === "top-left"){

            element.style.left = "9%";
            element.style.top = "8%";

        }else if(pos === "top-center"){

            element.style.left = "50%";
            element.style.top = "8%";

        }else if(pos === "top-right"){

            element.style.left = "91%";
            element.style.top = "8%";

        }else if(pos === "center-left"){

            element.style.left = "9%";
            element.style.top = "50%";

        }else if(pos === "center-right"){

            element.style.left = "91%";
            element.style.top = "50%";

        }else if(pos === "bottom-left"){

            element.style.left = "9%";
            element.style.top = "92%";

        }else if(pos === "bottom-center"){

            element.style.left = "50%";
            element.style.top = "92%";

        }else if(pos === "bottom-right"){

            element.style.left = "91%";
            element.style.top = "92%";

        }else{

            element.style.left = "50%";
            element.style.top = "50%";

        }

    }

    function updateWatermarkPreview(){

        const element =
            $("pp11WatermarkPreview");

        if(!element)
            return;

        const text =
            $("pp11WatermarkText").value ||
            "CONFIDENTIAL";

        const size =
            Number(
                $("pp11WatermarkSize").value || 48
            );

        const angle =
            Number(
                $("pp11WatermarkAngle").value || 0
            );

        const opacity =
            Number(
                $("pp11WatermarkOpacity").value || 18
            ) / 100;

        const color =
            $("pp11WatermarkColor").value ||
            "#333333";

        element.textContent = text;
        element.style.fontSize =
            Math.max(6,size) + "px";

        element.style.color = color;
        element.style.opacity = opacity;

        element.style.transform =
            "translate(-50%,-50%) rotate(" +
            angle +
            "deg)";

        positionWatermark(element);

        const value =
            $("pp11WatermarkOpacityValue");

        if(value)
            value.textContent =
                Math.round(opacity * 100) + "%";

    }

    function applyWatermark(){

        if(!state.file){

            status("Select a PDF first.");
            return;

        }

        const fd = new FormData();

        fd.append(
            "file",
            state.file
        );

        fd.append(
            "text",
            $("pp11WatermarkText").value
        );

        fd.append(
            "size",
            $("pp11WatermarkSize").value
        );

        fd.append(
            "opacity",
            Number(
                $("pp11WatermarkOpacity").value
            ) / 100
        );

        fd.append(
            "angle",
            $("pp11WatermarkAngle").value
        );

        fd.append(
            "color",
            $("pp11WatermarkColor").value
        );

        fd.append(
            "position",
            state.watermarkPosition
        );

        fd.append(
            "tiled",
            $("pp11WatermarkTiled").checked
        );

        fd.append("bold","true");
        fd.append("outline","false");

        if(typeof window.send === "function"){

            window.send(
                "/api/watermark",
                fd,
                "Watermarked.pdf"
            );

        }

    }

    function previousPage(){

        if(!state.pages.length)
            return;

        state.current =
            Math.max(
                0,
                state.current - 1
            );

        renderCurrentPage();

    }

    function nextPage(){

        if(!state.pages.length)
            return;

        state.current =
            Math.min(
                state.pages.length - 1,
                state.current + 1
            );

        renderCurrentPage();

    }

    function downloadBlob(blob,name){

        const url =
            URL.createObjectURL(blob);

        const a =
            document.createElement("a");

        a.href = url;
        a.download = name;

        document.body.appendChild(a);
        a.click();
        a.remove();

        setTimeout(function(){
            URL.revokeObjectURL(url);
        },1500);

    }

    function reset(){

        state.file = null;
        state.pages = [];
        state.current = 0;
        state.selected.clear();
        state.previewRotation = 0;
        state.cropPreview = 0;

        const input =
            $("pp11SourceFile");

        if(input)
            input.value = "";

        const name =
            $("pp11SourceName");

        if(name)
            name.textContent =
                "No document selected";

        if($("pp11PageRange"))
            $("pp11PageRange").value = "";

        if($("pp11CropMargin"))
            $("pp11CropMargin").value = "0";

        renderPageList();
        renderCurrentPage();
        updateSelectionUI();

        status(
            "Editing workspace reset."
        );

    }

    window.PP11 = {

        load:load,

        selectAll:selectAll,

        clearSelection:clearSelection,

        selectRange:selectRange,

        rotatePreview:rotatePreview,

        rotateSelected:rotateSelected,

        previousPage:previousPage,

        nextPage:nextPage,

        applyResize:applyResize,

        previewCrop:previewCrop,

        applyCrop:applyCrop,

        applyNumbers:applyNumbers,

        updateWatermarkPreview:updateWatermarkPreview,

        applyWatermark:applyWatermark,

        reset:reset

    };

    function install(){

        const input =
            $("pp11SourceFile");

        if(input){

            input.addEventListener(
                "change",
                load
            );

        }

        const opacity =
            $("pp11WatermarkOpacity");

        if(opacity){

            opacity.addEventListener(
                "input",
                updateWatermarkPreview
            );

        }

        [
            "pp11WatermarkText",
            "pp11WatermarkSize",
            "pp11WatermarkAngle",
            "pp11WatermarkColor"
        ].forEach(function(id){

            const element = $(id);

            if(element){

                element.addEventListener(
                    "input",
                    updateWatermarkPreview
                );

                element.addEventListener(
                    "change",
                    updateWatermarkPreview
                );

            }

        });

        document
            .querySelectorAll(".pp11-position-btn")
            .forEach(function(button){

                button.addEventListener(
                    "click",
                    function(){

                        document
                            .querySelectorAll(
                                ".pp11-position-btn"
                            )
                            .forEach(function(item){

                                item.classList.remove(
                                    "active"
                                );

                            });

                        button.classList.add("active");

                        state.watermarkPosition =
                            button.dataset.pos ||
                            "center";

                        updateWatermarkPreview();

                    }
                );

            });

        /*
         * Add workspace to Advanced navigation.
         */

        const groups =
            [...document.querySelectorAll(".navgroup")];

        let advancedNav = null;

        groups.forEach(function(group){

            const title =
                group.querySelector(".navtitle");

            if(
                title &&
                title.textContent
                    .trim()
                    .toLowerCase()
                    === "advanced"
            ){

                advancedNav =
                    group.querySelector(".nav");

            }

        });

        if(
            advancedNav &&
            !document.getElementById(
                "pp11EditingWorkspaceNav"
            )
        ){

            const button =
                document.createElement("button");

            button.id =
                "pp11EditingWorkspaceNav";

            button.type =
                "button";

            button.innerHTML =
                "&#9998; <span>PDF Editing Workspace</span>";

            button.onclick =
                function(){

                    if(typeof window.show === "function"){

                        window.show(
                            "pp11EditingWorkspace",
                            button
                        );

                    }

                    const section =
                        $("pp11EditingWorkspace");

                    if(section)
                        section.style.display = "";

                };

            advancedNav.appendChild(button);

        }

        renderPageList();
        renderCurrentPage();
        updateWatermarkPreview();

    }

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            install
        );

    }else{

        install();

    }

})();

</script>


<script id="upgrade-12-1-professional-annotation-js">
(function(){

const state = {
    file:null,
    pages:[],
    totalPages:0,
    page:0,
    tool:'select',
    annotations:{},
    undo:[],
    redo:[],
    drag:null,
    selectedId:null
};

const E = id =>
    document.getElementById(id);

const current = () =>
    state.annotations[state.page] ||
    (state.annotations[state.page] = []);

const clone = () =>
    JSON.parse(
        JSON.stringify(
            state.annotations
        )
    );

function status(t){

    const n =
        E('pp12FileStatus');

    if(n)
        n.textContent = t;
}

function snap(){

    state.undo.push(
        clone()
    );

    if(state.undo.length > 60)
        state.undo.shift();

    state.redo = [];
}

function clamp(v){

    return Math.max(
        0,
        Math.min(
            1,
            v
        )
    );
}

function pt(e){

    const r =
        E('pp12Layer')
        .getBoundingClientRect();

    return {
        x:clamp(
            (e.clientX-r.left)/r.width
        ),

        y:clamp(
            (e.clientY-r.top)/r.height
        )
    };
}

function range(s,total){

    const o = [];

    (s || '')
        .split(',')
        .forEach(
            t => {

                t = t.trim();

                if(/^\d+$/.test(t)){

                    let n = +t;

                    if(
                        n >= 1 &&
                        n <= total
                    )
                        o.push(n-1);

                }

                else if(
                    /^\d+\s*-\s*\d+$/.test(t)
                ){

                    let [a,b] =
                        t.split('-').map(Number);

                    if(a>b)
                        [a,b] = [b,a];

                    for(
                        let n=a;
                        n<=b;
                        n++
                    ){

                        if(
                            n>=1 &&
                            n<=total
                        )
                            o.push(n-1);
                    }
                }
            }
        );

    return [
        ...new Set(o)
    ].sort(
        (a,b)=>a-b
    );
}

function setTool(t,b){

    state.tool = t;

    document
        .querySelectorAll(
            '.pp12-tool[data-tool]'
        )
        .forEach(
            x =>
                x.classList.remove(
                    'active'
                )
        );

    (
        b ||
        document.querySelector(
            '.pp12-tool[data-tool="' +
            t +
            '"]'
        )
    )?.classList.add(
        'active'
    );

    const h =
        E('pp12Hint');

    if(h){

        h.textContent = {

            select:
                'Select an annotation to move or delete it.',

            text:
                'Enter text at right, then click the page to place it.',

            highlight:
                'Drag across PDF text to create a precise native highlight.',

            underline:
                'Drag across PDF text to create a precise native underline.',

            strikeout:
                'Drag across PDF text to create a precise native strikeout.',

            draw:
                'Draw freehand on the page.',

            rectangle:
                'Drag to draw a box.',

            arrow:
                'Drag from start to end.'

        }[t] || '';
    }
}

function wordsIn(a,b){

    const x0 =
        Math.min(
            a.x,
            b.x
        );

    const x1 =
        Math.max(
            a.x,
            b.x
        );

    const y0 =
        Math.min(
            a.y,
            b.y
        );

    const y1 =
        Math.max(
            a.y,
            b.y
        );

    return (
        state.pages[
            state.page
        ]?.words || []
    ).filter(
        w =>
            w.x+w.w/2 >= x0 &&
            w.x+w.w/2 <= x1 &&
            w.y+w.h/2 >= y0 &&
            w.y+w.h/2 <= y1
    );
}

function makeTextAnn(
    type,
    ws
){

    if(!ws.length)
        return null;

    const boxes =
        ws.map(
            w => ({
                x:w.x,
                y:w.y,
                w:w.w,
                h:w.h
            })
        );

    const x =
        Math.min(
            ...boxes.map(
                b=>b.x
            )
        );

    const y =
        Math.min(
            ...boxes.map(
                b=>b.y
            )
        );

    const r =
        Math.max(
            ...boxes.map(
                b=>b.x+b.w
            )
        );

    const bottom =
        Math.max(
            ...boxes.map(
                b=>b.y+b.h
            )
        );

    return {

        id:crypto.randomUUID(),

        type,

        x,

        y,

        w:r-x,

        h:bottom-y,

        boxes,

        color:
            E('pp12Color').value,

        opacity:
            +E('pp12Opacity').value/100,

        stroke:
            +E('pp12Stroke').value
    };
}

function render(){

    const layer =
        E('pp12Layer');

    if(!layer)
        return;

    layer.innerHTML = '';

    const wl =
        document.createElement(
            'div'
        );

    wl.id =
        'pp12WordLayer';

    wl.className =
        'pp12-word-layer';

    (
        state.pages[
            state.page
        ]?.words || []
    ).forEach(
        w => {

            const n =
                document.createElement(
                    'div'
                );

            n.className =
                'pp12-word';

            n.style.cssText =
                `left:${w.x*100}%;
                 top:${w.y*100}%;
                 width:${w.w*100}%;
                 height:${w.h*100}%;`;

            n.title =
                w.text;

            wl.appendChild(n);
        }
    );

    layer.appendChild(
        wl
    );

    current().forEach(
        a => {

            if(a.type === 'draw'){

                const svg =
                    document.createElementNS(
                        'http://www.w3.org/2000/svg',
                        'svg'
                    );

                svg.classList.add(
                    'pp12-draw-svg'
                );

                const p =
                    document.createElementNS(
                        'http://www.w3.org/2000/svg',
                        'polyline'
                    );

                p.classList.add(
                    'pp12-draw-path'
                );

                p.setAttribute(
                    'points',
                    a.points.map(
                        q =>
                            q.x*100 +
                            ',' +
                            q.y*100
                    ).join(' ')
                );

                p.setAttribute(
                    'stroke',
                    a.color
                );

                p.setAttribute(
                    'stroke-width',
                    a.stroke
                );

                p.setAttribute(
                    'stroke-linecap',
                    'round'
                );

                p.setAttribute(
                    'stroke-linejoin',
                    'round'
                );

                p.setAttribute(
                    'opacity',
                    a.opacity
                );

                p.dataset.id =
                    a.id;

                svg.appendChild(
                    p
                );

                layer.appendChild(
                    svg
                );

                return;
            }

            const n =
                document.createElement(
                    'div'
                );

            n.className =
                'pp12-annotation selectable' +
                (
                    a.id === state.selectedId
                        ? ' selected'
                        : ''
                );

            n.dataset.id =
                a.id;

            n.style.left =
                a.x*100 + '%';

            n.style.top =
                a.y*100 + '%';

            n.style.width =
                (a.w || .01)*100 + '%';

            n.style.height =
                (a.h || .01)*100 + '%';

            n.style.color =
                a.color;

            n.style.opacity =
                a.opacity;

            if(a.type === 'highlight')
                n.classList.add(
                    'pp12-highlight'
                );

            if(a.type === 'underline')
                n.classList.add(
                    'pp12-underline'
                );

            if(a.type === 'strikeout')
                n.classList.add(
                    'pp12-strike'
                );

            if(a.type === 'rectangle')
                n.classList.add(
                    'pp12-rect'
                );

            if(a.type === 'text'){

                n.classList.add(
                    'pp12-text'
                );

                n.style.fontSize =
                    a.size + 'px';

                n.textContent =
                    a.text;
            }

            n.addEventListener(
                'pointerdown',
                e => {

                    e.stopPropagation();

                    if(state.tool === 'select'){

                        state.selectedId =
                            a.id;

                        state.drag = {

                            mode:'move',

                            id:a.id,

                            start:pt(e),

                            ox:a.x,

                            oy:a.y
                        };

                        layer.setPointerCapture?.(
                            e.pointerId
                        );

                        render();
                    }
                }
            );

            layer.appendChild(
                n
            );
        }
    );
}

function start(e){

    if(!state.file)
        return;

    const p = pt(e);

    state.drag = {

        mode:state.tool,

        start:p,

        points:[p]
    };

    E('pp12Layer')
        .setPointerCapture?.(
            e.pointerId
        );
}

function move(e){

    const d =
        state.drag;

    if(!d)
        return;

    const p = pt(e);

    if(d.mode === 'move'){

        const a =
            current().find(
                x=>x.id===d.id
            );

        if(a){

            a.x =
                clamp(
                    d.ox +
                    p.x -
                    d.start.x
                );

            a.y =
                clamp(
                    d.oy +
                    p.y -
                    d.start.y
                );

            render();
        }

        return;
    }

    if(d.mode === 'draw'){

        d.points.push(
            p
        );

        render();

        return;
    }

    let q =
        E(
            'pp12SelectionPreview'
        );

    if(!q){

        q =
            document.createElement(
                'div'
            );

        q.id =
            'pp12SelectionPreview';

        q.className =
            'pp12-selection-preview';

        E('pp12Layer')
            .appendChild(
                q
            );
    }

    q.style.left =
        Math.min(
            d.start.x,
            p.x
        )*100 + '%';

    q.style.top =
        Math.min(
            d.start.y,
            p.y
        )*100 + '%';

    q.style.width =
        Math.abs(
            p.x -
            d.start.x
        )*100 + '%';

    q.style.height =
        Math.abs(
            p.y -
            d.start.y
        )*100 + '%';
}

function finish(e){

    const d =
        state.drag;

    if(!d)
        return;

    state.drag = null;

    const p = pt(e);

    const layer =
        E('pp12Layer');

    layer
        .querySelector(
            '#pp12SelectionPreview'
        )?.remove();

    if(d.mode === 'move'){

        snap();

        render();

        return;
    }

    if(d.mode === 'draw'){

        if(d.points.length > 1){

            snap();

            current().push({

                id:crypto.randomUUID(),

                type:'draw',

                points:d.points,

                color:
                    E('pp12Color').value,

                opacity:
                    +E('pp12Opacity').value/100,

                stroke:
                    +E('pp12Stroke').value
            });

            render();
        }

        return;
    }

    if(
        [
            'highlight',
            'underline',
            'strikeout'
        ].includes(
            d.mode
        )
    ){

        const ws =
            wordsIn(
                d.start,
                p
            );

        if(!ws.length){

            status(
                'No PDF text found in that area. Drag across the printed text.'
            );

            return;
        }

        snap();

        const a =
            makeTextAnn(
                d.mode,
                ws
            );

        current().push(
            a
        );

        state.selectedId =
            a.id;

        render();

        status(
            ws.length +
            ' PDF words annotated.'
        );

        return;
    }

    if(
        d.mode === 'rectangle' ||
        d.mode === 'arrow'
    ){

        const x =
            Math.min(
                d.start.x,
                p.x
            );

        const y =
            Math.min(
                d.start.y,
                p.y
            );

        const w =
            Math.abs(
                p.x -
                d.start.x
            );

        const h =
            Math.abs(
                p.y -
                d.start.y
            );

        if(
            w < .005 &&
            h < .005
        )
            return;

        snap();

        const a = {

            id:crypto.randomUUID(),

            type:d.mode,

            x,

            y,

            w,

            h,

            x2:p.x,

            y2:p.y,

            color:
                E('pp12Color').value,

            opacity:
                +E('pp12Opacity').value/100,

            stroke:
                +E('pp12Stroke').value
        };

        current().push(
            a
        );

        state.selectedId =
            a.id;

        render();
    }
}

function addText(e){

    const text =
        (
            E('pp12Text').value ||
            ''
        ).trim();

    if(!text){

        status(
            'Enter text in the TEXT field first.'
        );

        return;
    }

    const p = pt(e);

    snap();

    const size =
        +E('pp12TextSize').value ||
        18;

    const a = {

        id:crypto.randomUUID(),

        type:'text',

        x:p.x,

        y:p.y,

        w:.38,

        h:.09,

        text,

        size,

        color:
            E('pp12Color').value,

        opacity:
            +E('pp12Opacity').value/100
    };

    current().push(
        a
    );

    state.selectedId =
        a.id;

    render();
}

async function fetchPage(i){

    const f =
        new FormData();

    f.append(
        'file',
        state.file
    );

    f.append(
        'page_index',
        i
    );

    f.append(
        'dpi',
        160
    );

    const r =
        await fetch(
            '/api/annotation-page',
            {
                method:'POST',
                body:f
            }
        );

    if(!r.ok)
        throw new Error(
            await r.text()
        );

    return r.json();
}

async function showPage(i){

    if(!state.file)
        return;

    state.page =
        Math.max(
            0,
            Math.min(
                i,
                state.totalPages - 1
            )
        );

    if(
        !state.pages[
            state.page
        ]
    ){

        status(
            'Rendering page ' +
            (state.page + 1) +
            '...'
        );

        state.pages[
            state.page
        ] =
            await fetchPage(
                state.page
            );
    }

    const d =
        state.pages[
            state.page
        ];

    E('pp12PageImage').src =
        d.image;

    E('pp12PageCounter').textContent =
        'Page ' +
        (state.page + 1) +
        ' / ' +
        state.totalPages;

    render();
}

async function loadFile(){

    const f =
        E('pp12File')
        .files[0];

    if(!f)
        return;

    state.file = f;

    state.pages = [];

    state.annotations = {};

    state.undo = [];

    state.redo = [];

    state.selectedId = null;

    state.page = 0;

    try{

        status(
            'Preparing high-resolution editor...'
        );

        const d =
            await fetchPage(
                0
            );

        state.pages[0] =
            d;

        state.totalPages =
            d.page_count || 1;

        await showPage(
            0
        );

        status(
            'PDF loaded. High-resolution editing is ready.'
        );

    }catch(e){

        console.error(e);

        status(
            'Could not load PDF: ' +
            e.message
        );
    }
}

function prev(){

    if(state.page > 0)
        showPage(
            state.page - 1
        );
}

function next(){

    if(
        state.page <
        state.totalPages - 1
    )
        showPage(
            state.page + 1
        );
}

function loadRange(){

    const p =
        range(
            E('pp12Range').value,
            state.totalPages
        );

    if(!p.length){

        status(
            'Enter a valid page range.'
        );

        return;
    }

    showPage(
        p[0]
    );

    status(
        'Range starts at page ' +
        (p[0] + 1) +
        '.'
    );
}

function undo(){

    if(!state.undo.length)
        return;

    state.redo.push(
        clone()
    );

    state.annotations =
        state.undo.pop();

    state.selectedId = null;

    render();
}

function redo(){

    if(!state.redo.length)
        return;

    state.undo.push(
        clone()
    );

    state.annotations =
        state.redo.pop();

    state.selectedId = null;

    render();
}

function clearCurrent(){

    if(!current().length)
        return;

    snap();

    state.annotations[
        state.page
    ] = [];

    state.selectedId = null;

    render();
}

function clearAll(){

    if(
        Object.keys(
            state.annotations
        ).length
    ){

        snap();

        state.annotations = {};

        state.selectedId = null;

        render();
    }
}

function deleteSelected(){

    if(!state.selectedId)
        return;

    const i =
        current().findIndex(
            a =>
                a.id ===
                state.selectedId
        );

    if(i < 0)
        return;

    snap();

    current().splice(
        i,
        1
    );

    state.selectedId = null;

    render();
}

function reset(){

    state.annotations = {};

    state.undo = [];

    state.redo = [];

    state.selectedId = null;

    setTool(
        'select'
    );

    render();

    status(
        state.file
            ? 'Workspace reset.'
            : 'Select a PDF to begin.'
    );
}

async function exportPDF(){

    if(!state.file){

        status(
            'Select a PDF first.'
        );

        return;
    }

    const m =
        E('pp12ApplyMode').value;

    const total =
        state.totalPages;

    const allowed =
        m === 'all'
            ? new Set(
                [...Array(total).keys()]
            )
            : m === 'range'
                ? new Set(
                    range(
                        E('pp12ApplyRange').value,
                        total
                    )
                )
                : new Set(
                    [state.page]
                );

    const out = [];

    Object.entries(
        state.annotations
    ).forEach(
        ([pi,arr]) => {

            const n = +pi;

            if(!allowed.has(n))
                return;

            arr.forEach(
                a => {

                    const c =
                        JSON.parse(
                            JSON.stringify(a)
                        );

                    delete c.id;

                    c.page = n;

                    out.push(c);
                }
            );
        }
    );

    if(!out.length){

        status(
            'No annotations found for the selected pages.'
        );

        return;
    }

    const f =
        new FormData();

    f.append(
        'file',
        state.file
    );

    f.append(
        'annotations',
        JSON.stringify(
            out
        )
    );

    status(
        'Exporting without rasterizing the original PDF...'
    );

    try{

        const r =
            await fetch(
                '/api/annotate',
                {
                    method:'POST',
                    body:f
                }
            );

        if(!r.ok)
            throw new Error(
                await r.text()
            );

        const u =
            URL.createObjectURL(
                await r.blob()
            );

        const a =
            document.createElement(
                'a'
            );

        a.href = u;

        a.download =
            'Annotated_PDF.pdf';

        document.body.appendChild(
            a
        );

        a.click();

        a.remove();

        setTimeout(
            () =>
                URL.revokeObjectURL(u),
            2000
        );

        status(
            'Export complete. Original PDF content was preserved.'
        );

    }catch(e){

        console.error(e);

        status(
            'Export failed: ' +
            e.message
        );
    }
}

function bind(){

    E('pp12File')?.addEventListener(
        'change',
        loadFile
    );

    const l =
        E('pp12Layer');

    if(l){

        l.addEventListener(
            'pointerdown',
            e => {

                if(
                    e.target.closest(
                        '.pp12-annotation'
                    )
                )
                    return;

                const word =
                    e.target.closest(
                        '.pp12-word'
                    );

                if(
                    word &&
                    [
                        'highlight',
                        'underline',
                        'strikeout'
                    ].includes(
                        state.tool
                    )
                ){

                    start(e);

                    return;
                }

                if(
                    state.tool === 'text'
                ){

                    addText(e);

                }else{

                    start(e);
                }
            }
        );

        l.addEventListener(
            'pointermove',
            move
        );

        l.addEventListener(
            'pointerup',
            finish
        );

        l.addEventListener(
            'pointercancel',
            finish
        );
    }

    E('pp12Stroke')?.addEventListener(
        'input',
        e =>
            E('pp12StrokeValue').textContent =
                e.target.value +
                ' px'
    );

    E('pp12Opacity')?.addEventListener(
        'input',
        e =>
            E('pp12OpacityValue').textContent =
                e.target.value +
                '%'
    );
}

window.PP12 = {

    setTool,

    prev,

    next,

    loadRange,

    undo,

    redo,

    clearCurrent,

    clearAll,

    reset,

    exportPDF,

    deleteSelected
};

if(
    document.readyState ===
    'loading'
)

    document.addEventListener(
        'DOMContentLoaded',
        bind
    );

else
    bind();

})();
</script>


</body></html>

<script id="upgrade-12-1-annotation-navigation-dashboard-js">
(function(){

function go(){

    document
        .getElementById(
            'pp12AnnotationStudio'
        )
        ?.scrollIntoView({
            behavior:'smooth',
            block:'start'
        });
}

function install(){

    const bs = [
        ...document.querySelectorAll(
            'button'
        )
    ];

    const adv =
        bs.find(
            b =>
                b.textContent
                .trim()
                .toLowerCase() ===
                'advanced tools'
        );

    if(
        adv &&
        !document.getElementById(
            'pp12AnnotationStudioNav'
        )
    ){

        const b =
            document.createElement(
                'button'
            );

        b.id =
            'pp12AnnotationStudioNav';

        b.className =
            adv.className;

        b.textContent =
            '📝 Annotation Studio';

        b.onclick =
            go;

        adv.parentElement
            ?.appendChild(
                b
            );
    }

    const ed =
        bs.find(
            b =>
                b.textContent
                .toLowerCase()
                .includes(
                    'pdf editing workspace'
                )
        );

    if(
        ed &&
        !document.getElementById(
            'pp12DashboardAnnotationButton'
        )
    ){

        const b =
            document.createElement(
                'button'
            );

        b.id =
            'pp12DashboardAnnotationButton';

        b.className =
            ed.className;

        b.textContent =
            '📝 Annotation Studio';

        b.onclick =
            go;

        ed.parentElement
            ?.appendChild(
                b
            );
    }
}

if(
    document.readyState ===
    'loading'
)

    document.addEventListener(
        'DOMContentLoaded',
        () =>
            setTimeout(
                install,
                300
            )
    );

else

    setTimeout(
        install,
        300
    );

new MutationObserver(
    install
).observe(
    document.body,
    {
        childList:true,
        subtree:true
    }
);

})();
</script>
