<script id="visual-page-manager-js">

(function(){

    const state = {
        file: null,
        pages: [],
        selected: new Set(),
        dragIndex: null,
        loading: false
    };

    function $(id){
        return document.getElementById(id);
    }

    function setStatus(text){
        const el = $("pp4Status");
        if(el) el.textContent = text;
    }

    function updateCount(){
        const total = state.pages.length;
        const selected = state.selected.size;

        const el = $("pp4Count");

        if(el){
            el.textContent =
                total + " pages • " + selected + " selected";
        }
    }

    function progress(value, visible){
        const box = $("pp4Progress");
        if(!box) return;

        box.style.display = visible ? "block" : "none";

        const bar = box.querySelector("span");

        if(bar){
            bar.style.width = Math.max(
                0,
                Math.min(100, value)
            ) + "%";
        }
    }

    function open(){
        $("pp4VisualPageManager").classList.remove("hidden");
    }

    function close(){
        $("pp4VisualPageManager").classList.add("hidden");
    }

    function selectedPages(){

        return state.pages
            .filter(p => state.selected.has(p.id))
            .map(p => p.num);

    }

    function selectedSpec(){

        return selectedPages().join(",");

    }

    function render(){

        const container = $("pp4Pages");

        if(!container) return;

        container.innerHTML = "";

        if(!state.pages.length){

            container.innerHTML = `
                <div class="pp4-empty">
                    <strong>No pages available</strong>
                    <span>Load a PDF to see its pages.</span>
                </div>
            `;

            updateCount();
            return;
        }

        state.pages.forEach((page,index)=>{

            const card = document.createElement("div");

            card.className =
                "pp4-page" +
                (state.selected.has(page.id) ? " selected" : "");

            card.draggable = true;

            card.dataset.index = index;

            card.addEventListener("dragstart", function(){

                state.dragIndex = index;

                card.classList.add("dragging");

            });

            card.addEventListener("dragend", function(){

                state.dragIndex = null;

                card.classList.remove("dragging");

            });

            card.addEventListener("dragover", function(e){

                e.preventDefault();

            });

            card.addEventListener("drop", function(e){

                e.preventDefault();

                const from = state.dragIndex;
                const to = index;

                if(
                    from === null ||
                    from === undefined ||
                    from === to
                ){
                    return;
                }

                const moved = state.pages.splice(from,1)[0];

                state.pages.splice(to,0,moved);

                render();

                setStatus(
                    "Page order changed. Click Apply Order to create the reordered PDF."
                );

            });

            const checked =
                state.selected.has(page.id)
                    ? "checked"
                    : "";

            card.innerHTML = `
                <img
                    class="pp4-thumb"
                    src="${page.data}"
                    alt="Page ${page.num}"
                    loading="lazy"
                >

                <div class="pp4-page-meta">

                    <input
                        class="pp4-check"
                        type="checkbox"
                        ${checked}
                        aria-label="Select page ${page.num}"
                    >

                    <span class="pp4-number">
                        Page ${page.num}
                    </span>

                    <span class="pp4-drag">
                        &#8942;&#8942;
                    </span>

                </div>
            `;

            const checkbox =
                card.querySelector(".pp4-check");

            checkbox.addEventListener("click",function(e){

                e.stopPropagation();

            });

            checkbox.addEventListener("change",function(){

                if(this.checked){
                    state.selected.add(page.id);
                }else{
                    state.selected.delete(page.id);
                }

                updateCount();

                card.classList.toggle(
                    "selected",
                    this.checked
                );

            });

            card.addEventListener("click",function(e){

                if(e.target === checkbox){
                    return;
                }

                if(state.selected.has(page.id)){
                    state.selected.delete(page.id);
                }else{
                    state.selected.add(page.id);
                }

                render();

            });

            container.appendChild(card);

        });

        updateCount();
    }

    async function load(){

        const input = $("pp4File");

        if(!input || !input.files.length){

            setStatus("Please choose a PDF first.");

            return;
        }

        const file = input.files[0];

        if(
            file.type &&
            file.type !== "application/pdf" &&
            !file.name.toLowerCase().endsWith(".pdf")
        ){

            setStatus("Please choose a PDF file.");

            return;
        }

        state.file = file;
        state.pages = [];
        state.selected = new Set();

        render();

        setStatus(
            "Generating page previews..."
        );

        progress(5,true);

        const fd = new FormData();

        fd.append("file",file);
        fd.append("max_pages","150");
        fd.append("thumb_width","240");
        fd.append("quality","72");

        try{

            const response =
                await fetch(
                    "/api/page-thumbnails",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            if(!response.ok){

                let message =
                    "Unable to load PDF.";

                try{

                    const err =
                        await response.json();

                    if(err.detail){
                        message = err.detail;
                    }

                }catch(_){}

                throw new Error(message);
            }

            const data =
                await response.json();

            state.pages =
                data.pages.map(function(page){

                    return {
                        id:"p" + page.page + "_" +
                            Math.random()
                                .toString(36)
                                .slice(2),

                        num:page.page,

                        data:page.data
                    };

                });

            state.selected = new Set();

            render();

            if(data.truncated){

                setStatus(
                    "Showing first " +
                    data.rendered_pages +
                    " of " +
                    data.total_pages +
                    " pages. Large-PDF preview is limited."
                );

            }else{

                setStatus(
                    "Loaded " +
                    data.total_pages +
                    " pages. Drag pages to reorder."
                );

            }

            progress(100,true);

            setTimeout(function(){
                progress(0,false);
            },500);

        }catch(error){

            progress(0,false);

            setStatus(
                error.message ||
                "Unable to generate page previews."
            );

        }

    }

    function requireFile(){

        if(!state.file){

            setStatus("Load a PDF first.");

            return false;
        }

        if(!state.pages.length){

            setStatus("No pages are loaded.");

            return false;
        }

        return true;
    }

    function selectAll(){

        state.selected = new Set(
            state.pages.map(p=>p.id)
        );

        render();

    }

    function selectNone(){

        state.selected.clear();

        render();

    }

    function selectOdd(){

        state.selected = new Set(
            state.pages
                .filter(p => p.num % 2 === 1)
                .map(p => p.id)
        );

        render();

    }

    function selectEven(){

        state.selected = new Set(
            state.pages
                .filter(p => p.num % 2 === 0)
                .map(p => p.id)
        );

        render();

    }

    function invertSelection(){

        const next = new Set();

        state.pages.forEach(function(page){

            if(!state.selected.has(page.id)){
                next.add(page.id);
            }

        });

        state.selected = next;

        render();

    }

    async function downloadResponse(
        response,
        filename
    ){

        if(!response.ok){

            let message = "Operation failed.";

            try{

                const err =
                    await response.json();

                if(err.detail){
                    message = err.detail;
                }

            }catch(_){}

            throw new Error(message);
        }

        const blob =
            await response.blob();

        const url =
            URL.createObjectURL(blob);

        const a =
            document.createElement("a");

        a.href = url;
        a.download = filename;

        document.body.appendChild(a);

        a.click();

        a.remove();

        setTimeout(function(){
            URL.revokeObjectURL(url);
        },1000);

    }

    async function deleteSelected(){

        if(!requireFile()) return;

        const pages = selectedSpec();

        if(!pages){

            setStatus("Select at least one page.");

            return;
        }

        if(
            state.selected.size >=
            state.pages.length
        ){

            setStatus(
                "You cannot delete every page from the PDF."
            );

            return;
        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("pages",pages);
        fd.append("action","delete");

        setStatus(
            "Deleting selected pages..."
        );

        try{

            const response =
                await fetch(
                    "/api/pages",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            await downloadResponse(
                response,
                "Deleted_Selected_Pages.pdf"
            );

            setStatus(
                "Deleted-pages PDF downloaded."
            );

        }catch(error){

            setStatus(
                error.message ||
                "Delete operation failed."
            );

        }

    }

    async function extractSelected(){

        if(!requireFile()) return;

        const pages = selectedSpec();

        if(!pages){

            setStatus("Select at least one page.");

            return;
        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("pages",pages);
        fd.append("action","extract");

        setStatus(
            "Extracting selected pages..."
        );

        try{

            const response =
                await fetch(
                    "/api/pages",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            await downloadResponse(
                response,
                "Extracted_Selected_Pages.pdf"
            );

            setStatus(
                "Extracted-pages PDF downloaded."
            );

        }catch(error){

            setStatus(
                error.message ||
                "Extract operation failed."
            );

        }

    }

    async function rotate(degrees){

        if(!requireFile()) return;

        const pages = selectedSpec();

        if(!pages){

            setStatus(
                "Select pages before rotating."
            );

            return;
        }

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("pages",pages);
        fd.append("degrees",String(degrees));

        setStatus(
            "Rotating selected pages..."
        );

        try{

            const response =
                await fetch(
                    "/api/rotate-pages",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            await downloadResponse(
                response,
                "Rotated_Selected_Pages.pdf"
            );

            setStatus(
                "Rotated-pages PDF downloaded."
            );

        }catch(error){

            setStatus(
                error.message ||
                "Rotation failed."
            );

        }

    }

    async function applyOrder(){

        if(!requireFile()) return;

        if(state.pages.length < 2){

            setStatus(
                "At least two pages are needed for reordering."
            );

            return;
        }

        const order =
            state.pages
                .map(p=>p.num)
                .join(",");

        const fd = new FormData();

        fd.append("file",state.file);
        fd.append("pages",order);
        fd.append("action","reorder");

        setStatus(
            "Applying page order..."
        );

        try{

            const response =
                await fetch(
                    "/api/pages",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            await downloadResponse(
                response,
                "Reordered_Pages.pdf"
            );

            setStatus(
                "Reordered PDF downloaded."
            );

        }catch(error){

            setStatus(
                error.message ||
                "Reorder operation failed."
            );

        }

    }

    window.PP4PageManager = {
        open,
        close,
        load,
        render,
        selectAll,
        selectNone,
        selectOdd,
        selectEven,
        invertSelection,
        deleteSelected,
        extractSelected,
        rotate,
        applyOrder
    };

    /*
     * Add launcher inside existing Organize section.
     * Existing cards/routes remain untouched.
     */

    function installLauncher(){

        const organize =
            document.getElementById("organize");

        if(!organize) return;

        if(
            document.getElementById(
                "pp4LaunchVisualManager"
            )
        ){
            return;
        }

        const heading =
            organize.querySelector("h2");

        if(!heading) return;

        const wrap =
            document.createElement("div");

        wrap.className =
            "pp4-launch-wrap";

        wrap.id =
            "pp4LaunchVisualManager";

        wrap.innerHTML = `
            <button
                type="button"
                class="pp4-launch"
                onclick="PP4PageManager.open()"
            >
                &#128444; Open Visual PDF Page Manager
                <span style="opacity:.7">
                    &nbsp; Preview &bull; Select &bull; Reorder &bull; Edit
                </span>
            </button>
        `;

        heading.insertAdjacentElement(
            "afterend",
            wrap
        );

    }

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            installLauncher
        );

    }else{

        installLauncher();

    }

})();

</script>


