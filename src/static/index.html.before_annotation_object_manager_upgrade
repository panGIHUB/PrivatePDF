<script id="upgrade-10-conversion-studio-js">

(function(){

    "use strict";

    function $(id){
        return document.getElementById(id);
    }

    function formatBytes(bytes){

        if(!Number.isFinite(bytes) || bytes <= 0)
            return "0 B";

        if(bytes < 1024)
            return bytes + " B";

        if(bytes < 1024 * 1024)
            return (bytes / 1024).toFixed(1) + " KB";

        if(bytes < 1024 * 1024 * 1024)
            return (bytes / (1024 * 1024)).toFixed(2) + " MB";

        return (bytes / (1024 * 1024 * 1024)).toFixed(2) + " GB";
    }

    function renderFiles(inputId, containerId){

        const input = $(inputId);
        const box = $(containerId);

        if(!input || !box)
            return;

        const files = [...input.files];

        if(!files.length){

            box.innerHTML = "";
            box.classList.remove("show");
            return;
        }

        box.classList.add("show");

        box.innerHTML = files.map(function(file){

            return `
                <div class="pp10-file-row">

                    <div class="pp10-file-row-icon">
                        📄
                    </div>

                    <div class="pp10-file-row-name">
                        ${String(file.name)
                            .replace(/&/g,"&amp;")
                            .replace(/</g,"&lt;")
                            .replace(/>/g,"&gt;")}
                    </div>

                    <div class="pp10-file-row-size">
                        ${formatBytes(file.size)}
                    </div>

                </div>
            `;

        }).join("");

    }

    function setupDrop(dropId,inputId,containerId){

        const drop = $(dropId);
        const input = $(inputId);

        if(!drop || !input)
            return;

        ["dragenter","dragover"].forEach(function(eventName){

            drop.addEventListener(
                eventName,
                function(event){

                    event.preventDefault();
                    drop.classList.add("dragging");

                }
            );

        });

        ["dragleave","drop"].forEach(function(eventName){

            drop.addEventListener(
                eventName,
                function(event){

                    event.preventDefault();
                    drop.classList.remove("dragging");

                }
            );

        });

        drop.addEventListener("drop",function(event){

            const files = [...event.dataTransfer.files];

            if(!files.length)
                return;

            try{

                const dt = new DataTransfer();

                files.forEach(function(file){
                    dt.items.add(file);
                });

                input.files = dt.files;
                renderFiles(inputId,containerId);

            }catch(error){

                console.warn(
                    "Drop assignment unavailable.",
                    error
                );

            }

        });

        input.addEventListener(
            "change",
            function(){

                renderFiles(inputId,containerId);

            }
        );

    }

    function requireFile(inputId){

        const input = $(inputId);

        if(!input || !input.files.length){

            if(typeof window.st === "function")
                window.st("Select a file first.");

            return null;
        }

        return input.files[0];

    }

    function runSend(url,formData,name){

        if(typeof window.send === "function"){

            window.send(
                url,
                formData,
                name
            );

            return true;
        }

        return false;
    }

    function convertPdfJpg(){

        const file =
            requireFile("pp10PdfJpgFile");

        if(!file)
            return;

        const fd = new FormData();

        fd.append("file",file);

        if(!runSend(
            "/api/pdf-to-jpg",
            fd,
            "PDF_to_JPG"
        )){

            if(typeof window.st === "function")
                window.st("Conversion engine unavailable.");

        }

    }

    function convertPdfOffice(){

        const file =
            requireFile("pp10PdfOfficeFile");

        if(!file)
            return;

        const kind =
            $("pp10OfficeKind").value;

        const fd = new FormData();

        fd.append("file",file);
        fd.append("kind",kind);

        if(!runSend(
            "/api/pdf-to-office",
            fd,
            "Converted_Office_File"
        )){

            if(typeof window.st === "function")
                window.st("Conversion engine unavailable.");

        }

    }

    function convertOfficePdf(){

        const file =
            requireFile("pp10OfficePdfFile");

        if(!file)
            return;

        const fd = new FormData();

        fd.append("file",file);

        if(!runSend(
            "/api/office-to-pdf",
            fd,
            "Converted.pdf"
        )){

            if(typeof window.st === "function")
                window.st("Conversion engine unavailable.");

        }

    }

    function convertImagesPdf(){

        const input =
            $("pp10ImagesPdfFilesInput");

        if(!input || !input.files.length){

            if(typeof window.st === "function")
                window.st("Select at least one image.");

            return;
        }

        const fd = new FormData();

        [...input.files].forEach(function(file){

            fd.append("files",file);

        });

        if(!runSend(
            "/api/images-to-pdf",
            fd,
            "Images_to_PDF.pdf"
        )){

            if(typeof window.st === "function")
                window.st("Conversion engine unavailable.");

        }

    }

    window.PP10 = {

        convertPdfJpg:convertPdfJpg,

        convertPdfOffice:convertPdfOffice,

        convertOfficePdf:convertOfficePdf,

        convertImagesPdf:convertImagesPdf

    };

    function install(){

        setupDrop(
            "pp10PdfJpgDrop",
            "pp10PdfJpgFile",
            "pp10PdfJpgFiles"
        );

        setupDrop(
            "pp10PdfOfficeDrop",
            "pp10PdfOfficeFile",
            "pp10PdfOfficeFiles"
        );

        setupDrop(
            "pp10OfficePdfDrop",
            "pp10OfficePdfFile",
            "pp10OfficePdfFiles"
        );

        setupDrop(
            "pp10ImagesPdfDrop",
            "pp10ImagesPdfFilesInput",
            "pp10ImagesPdfFiles"
        );

        /*
         * Add Conversion Studio to the existing navigation.
         */

        const navGroups =
            [...document.querySelectorAll(".navgroup")];

        let advancedNav = null;

        navGroups.forEach(function(group){

            const title =
                group.querySelector(".navtitle");

            if(
                title &&
                title.textContent.trim().toLowerCase()
                    === "advanced"
            ){

                advancedNav =
                    group.querySelector(".nav");

            }

        });

        if(advancedNav &&
           !document.getElementById("pp10ConversionNav")){

            const button =
                document.createElement("button");

            button.id =
                "pp10ConversionNav";

            button.type =
                "button";

            button.innerHTML =
                "&#128260; <span>Conversion Studio</span>";

            button.onclick =
                function(){

                    if(typeof window.show === "function")
                        window.show(
                            "pp10ConversionStudio",
                            button
                        );

                    const section =
                        $("pp10ConversionStudio");

                    if(section)
                        section.style.display = "";

                };

            advancedNav.appendChild(button);

        }

    }

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            install
        );

    }else{

        install();

    }

})();

</script>


