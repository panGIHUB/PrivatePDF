<script id="professional-workspace-js">
/* ===== PROFESSIONAL FILE WORKSPACE ===== */

window.PPDFWorkspace = {
  files: [],

  formatBytes(bytes){
    if(!bytes) return "0 B";
    const units=["B","KB","MB","GB"];
    const i=Math.floor(Math.log(bytes)/Math.log(1024));
    return (bytes/Math.pow(1024,i)).toFixed(i?1:0)+" "+units[i];
  },

  escape(str){
    return String(str).replace(/[&<>"']/g,m=>({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    }[m]));
  },

  add(input){
    const incoming=[...input.files];

    incoming.forEach(file=>{
      const exists=this.files.some(
        x=>x.name===file.name &&
        x.size===file.size &&
        x.lastModified===file.lastModified
      );

      if(!exists) this.files.push(file);
    });

    this.render();
  },

  remove(index){
    this.files.splice(index,1);
    this.render();
  },

  clear(){
    this.files=[];
    this.render();
  },

  render(){
    const grid=document.getElementById("ppWorkspaceFiles");
    const count=document.getElementById("ppWorkspaceCount");
    if(!grid) return;

    grid.innerHTML="";

    if(!this.files.length){
      grid.innerHTML='<div class="workspace-empty">No files added yet</div>';
    }else{
      this.files.forEach((file,index)=>{
        const card=document.createElement("div");
        card.className="workspace-file";

        const thumb=document.createElement("div");
        thumb.className="workspace-thumb";

        const isImage=file.type.startsWith("image/");
        const isPdf=file.type==="application/pdf" ||
                    file.name.toLowerCase().endsWith(".pdf");

        if(isImage){
          const img=document.createElement("img");
          img.src=URL.createObjectURL(file);
          thumb.appendChild(img);
        }else{
          thumb.textContent=isPdf ? "📄" : "📁";
        }

        const meta=document.createElement("div");
        meta.className="workspace-meta";

        const name=document.createElement("div");
        name.className="workspace-name";
        name.title=file.name;
        name.textContent=file.name;

        const info=document.createElement("div");
        info.className="workspace-info";
        info.textContent=this.formatBytes(file.size);

        meta.appendChild(name);
        meta.appendChild(info);

        const remove=document.createElement("button");
        remove.className="workspace-remove";
        remove.type="button";
        remove.title="Remove file";
        remove.textContent="✕";
        remove.onclick=()=>this.remove(index);

        card.appendChild(thumb);
        card.appendChild(meta);
        card.appendChild(remove);

        grid.appendChild(card);
      });
    }

    if(count){
      count.textContent=
        this.files.length+
        (this.files.length===1?" file":" files")+
        " • "+
        this.formatBytes(this.files.reduce((a,f)=>a+f.size,0));
    }
  }
};

function ppWorkspaceFiles(input){
  PPDFWorkspace.add(input);
  input.value="";
}

function ppWorkspaceClear(){
  PPDFWorkspace.clear();
}

function ppWorkspaceDrop(e){
  e.preventDefault();
  const zone=document.getElementById("ppWorkspaceDrop");
  if(zone) zone.classList.remove("dragover");

  if(e.dataTransfer && e.dataTransfer.files.length){
    PPDFWorkspace.add(e.dataTransfer);
  }
}

function ppWorkspaceDrag(e){
  e.preventDefault();
  const zone=document.getElementById("ppWorkspaceDrop");
  if(zone) zone.classList.add("dragover");
}

function ppWorkspaceLeave(e){
  e.preventDefault();
  const zone=document.getElementById("ppWorkspaceDrop");
  if(zone) zone.classList.remove("dragover");
}

document.addEventListener("DOMContentLoaded",()=>{
  PPDFWorkspace.render();
});
</script>


