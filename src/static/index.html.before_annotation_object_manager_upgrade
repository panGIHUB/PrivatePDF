<style id="professional-workspace-css">
/* ===== PROFESSIONAL WORKSPACE LAYER ===== */
.workspace-shell{
  margin:18px 0;
  border:1px solid rgba(255,255,255,.10);
  border-radius:18px;
  background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.018));
  box-shadow:0 16px 50px rgba(0,0,0,.18);
  overflow:hidden;
}

.workspace-head{
  padding:18px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  border-bottom:1px solid rgba(255,255,255,.08);
}

.workspace-title{
  font-size:17px;
  font-weight:700;
}

.workspace-subtitle{
  margin-top:4px;
  opacity:.62;
  font-size:12px;
}

.workspace-actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.workspace-drop{
  margin:18px;
  padding:30px 20px;
  border:1.5px dashed rgba(255,255,255,.20);
  border-radius:16px;
  text-align:center;
  cursor:pointer;
  transition:.2s ease;
  background:rgba(255,255,255,.018);
}

.workspace-drop:hover,
.workspace-drop.dragover{
  border-color:rgba(255,255,255,.55);
  background:rgba(255,255,255,.055);
  transform:translateY(-1px);
}

.workspace-drop-icon{
  font-size:32px;
  margin-bottom:8px;
}

.workspace-drop-title{
  font-size:15px;
  font-weight:650;
}

.workspace-drop-text{
  margin-top:5px;
  opacity:.55;
  font-size:12px;
}

.workspace-files{
  padding:0 18px 18px;
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:10px;
}

.workspace-empty{
  grid-column:1/-1;
  text-align:center;
  padding:24px;
  opacity:.45;
  font-size:13px;
}

.workspace-file{
  position:relative;
  display:flex;
  align-items:center;
  gap:11px;
  padding:11px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:13px;
  background:rgba(255,255,255,.025);
  min-width:0;
  transition:.18s ease;
}

.workspace-file:hover{
  background:rgba(255,255,255,.055);
  border-color:rgba(255,255,255,.16);
}

.workspace-thumb{
  width:48px;
  height:48px;
  flex:0 0 48px;
  border-radius:10px;
  object-fit:cover;
  background:rgba(255,255,255,.07);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:21px;
  overflow:hidden;
}

.workspace-thumb img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.workspace-meta{
  min-width:0;
  flex:1;
}

.workspace-name{
  font-size:12px;
  font-weight:600;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.workspace-info{
  margin-top:4px;
  font-size:10px;
  opacity:.55;
  line-height:1.4;
}

.workspace-remove{
  border:0;
  background:transparent;
  opacity:.45;
  cursor:pointer;
  font-size:16px;
  padding:4px;
}

.workspace-remove:hover{
  opacity:1;
}

.workspace-footer{
  padding:12px 18px;
  border-top:1px solid rgba(255,255,255,.07);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

.workspace-count{
  font-size:11px;
  opacity:.58;
}

.workspace-status{
  font-size:11px;
  opacity:.72;
}

@media(max-width:650px){
  .workspace-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .workspace-files{
    grid-template-columns:1fr;
  }

  .workspace-drop{
    padding:24px 14px;
  }
}
</style>


