<script id="pdf-workspace-upgrade-js">

window.PPPDFWorkspace = {

  files: [],
  selected: -1,
  dragIndex: -1,

  formatBytes(bytes){

    if(!bytes) return "0 B";

    const units=["B","KB","MB","GB"];

    const i=Math.floor(
      Math.log(bytes)/Math.log(1024)
    );

    return (
      bytes / Math.pow(1024,i)
    ).toFixed(i ? 1 : 0)
    + " "
    + units[i];
  },

  isPDF(file){

    return (
      file.type === "application/pdf" ||
      file.name.toLowerCase().endsWith(".pdf")
    );
  },

  addFiles(list){

    [...list].forEach(file=>{

      if(!this.isPDF(file)){
        return;
      }

      const duplicate=this.files.some(x =>
        x.name === file.name &&
        x.size === file.size &&
        x.lastModified === file.lastModified
      );

      if(!duplicate){
        this.files.push(file);
      }
    });

    this.selected=this.files.length
      ? Math.min(
          this.selected < 0 ? 0 : this.selected,
          this.files.length-1
        )
      : -1;

    this.sync();
    this.render();
  },

  open(){

    const box=document.getElementById(
      "ppPdfWorkspace"
    );

    if(box){
      box.classList.add("open");
    }

    this.render();
  },

  close(){

    const box=document.getElementById(
      "ppPdfWorkspace"
    );

    if(box){
      box.classList.remove("open");
    }
  },

  addMore(){

    const input=document.getElementById(
      "ppPdfExtraInput"
    );

    if(input){
      input.click();
    }
  },

  remove(index){

    if(index < 0 || index >= this.files.length){
      return;
    }

    this.files.splice(index,1);

    if(this.selected >= this.files.length){
      this.selected=this.files.length-1;
    }

    this.sync();
    this.render();
  },

  clear(){

    this.files=[];

    this.selected=-1;

    this.sync();
    this.render();
  },

  select(index){

    if(index < 0 || index >= this.files.length){
      return;
    }

    this.selected=index;

    this.render();
  },

  swap(a,b){

    if(
      a < 0 ||
      b < 0 ||
      a >= this.files.length ||
      b >= this.files.length
    ){
      return;
    }

    const temp=this.files[a];

    this.files[a]=this.files[b];
    this.files[b]=temp;

    this.selected=b;

    this.sync();
    this.render();
  },

  moveUp(){

    if(this.selected > 0){
      this.swap(
        this.selected,
        this.selected-1
      );
    }
  },

  moveDown(){

    if(
      this.selected >= 0 &&
      this.selected < this.files.length-1
    ){
      this.swap(
        this.selected,
        this.selected+1
      );
    }
  },

  moveTop(){

    if(this.selected <= 0){
      return;
    }

    const f=this.files.splice(
      this.selected,
      1
    )[0];

    this.files.unshift(f);

    this.selected=0;

    this.sync();
    this.render();
  },

  moveBottom(){

    if(
      this.selected < 0 ||
      this.selected >= this.files.length-1
    ){
      return;
    }

    const f=this.files.splice(
      this.selected,
      1
    )[0];

    this.files.push(f);

    this.selected=this.files.length-1;

    this.sync();
    this.render();
  },

  dragStart(index,event){

    this.dragIndex=index;

    if(event.dataTransfer){
      event.dataTransfer.effectAllowed="move";

      try{
        event.dataTransfer.setData(
          "text/plain",
          String(index)
        );
      }catch(_){}
    }

    event.currentTarget.classList.add("dragging");
  },

  dragEnd(event){

    event.currentTarget.classList.remove(
      "dragging"
    );

    this.dragIndex=-1;
  },

  dragOverItem(index,event){

    event.preventDefault();

    if(this.dragIndex < 0){
      return;
    }

    if(this.dragIndex === index){
      return;
    }

    const moved=this.files.splice(
      this.dragIndex,
      1
    )[0];

    this.files.splice(
      index,
      0,
      moved
    );

    this.dragIndex=index;
    this.selected=index;

    this.sync();
    this.render();
  },

  dragOver(event){

    event.preventDefault();

    const zone=document.getElementById(
      "ppPdfDrop"
    );

    if(zone){
      zone.classList.add("dragover");
    }
  },

  dragLeave(event){

    event.preventDefault();

    const zone=document.getElementById(
      "ppPdfDrop"
    );

    if(zone){
      zone.classList.remove("dragover");
    }
  },

  drop(event){

    event.preventDefault();

    const zone=document.getElementById(
      "ppPdfDrop"
    );

    if(zone){
      zone.classList.remove("dragover");
    }

    if(event.dataTransfer?.files?.length){
      this.addFiles(
        event.dataTransfer.files
      );
    }
  },

  sync(){

    const input=document.getElementById(
      "mergeFiles"
    );

    if(!input){
      return;
    }

    try{

      const dt=new DataTransfer();

      this.files.forEach(file=>{
        dt.items.add(file);
      });

      input.files=dt.files;

    }catch(error){

      console.warn(
        "PDF workspace input sync failed",
        error
      );
    }
  },

  render(){

    const list=document.getElementById(
      "ppPdfList"
    );

    const summary=document.getElementById(
      "ppPdfSummary"
    );

    if(!list){
      return;
    }

    list.innerHTML="";

    if(!this.files.length){

      list.innerHTML=
        '<div class="pp-pdf-empty">' +
        'No PDF files added yet' +
        '</div>';

      if(summary){
        summary.textContent="0 files";
      }

      return;
    }

    let total=0;

    this.files.forEach((file,index)=>{

      total += file.size;

      const row=document.createElement("div");

      row.className="pp-pdf-item";

      row.draggable=true;

      if(index===this.selected){
        row.style.borderColor="#a5b4fc";
        row.style.background="#f8faff";
      }

      row.onclick=()=>{
        this.select(index);
      };

      row.ondragstart=(event)=>{
        this.dragStart(index,event);
      };

      row.ondragend=(event)=>{
        this.dragEnd(event);
      };

      row.ondragover=(event)=>{
        this.dragOverItem(index,event);
      };

      const grip=document.createElement("div");

      grip.className="pp-pdf-grip";
      grip.textContent="⋮⋮";

      const num=document.createElement("div");

      num.className="pp-pdf-index";
      num.textContent=index+1;

      const icon=document.createElement("div");

      icon.className="pp-pdf-icon";
      icon.textContent="📄";

      const info=document.createElement("div");

      info.className="pp-pdf-info";

      const name=document.createElement("div");

      name.className="pp-pdf-name";
      name.textContent=file.name;
      name.title=file.name;

      const meta=document.createElement("div");

      meta.className="pp-pdf-meta";

      meta.textContent=
        this.formatBytes(file.size);

      info.appendChild(name);
      info.appendChild(meta);

      const actions=document.createElement("div");

      actions.className="pp-pdf-actions";

      const up=document.createElement("button");

      up.type="button";
      up.title="Move up";
      up.textContent="↑";

      up.onclick=(event)=>{
        event.stopPropagation();
        this.selected=index;
        this.moveUp();
      };

      const down=document.createElement("button");

      down.type="button";
      down.title="Move down";
      down.textContent="↓";

      down.onclick=(event)=>{
        event.stopPropagation();
        this.selected=index;
        this.moveDown();
      };

      const remove=document.createElement("button");

      remove.type="button";
      remove.title="Remove";
      remove.textContent="×";

      remove.onclick=(event)=>{
        event.stopPropagation();
        this.remove(index);
      };

      actions.appendChild(up);
      actions.appendChild(down);
      actions.appendChild(remove);

      row.appendChild(grip);
      row.appendChild(num);
      row.appendChild(icon);
      row.appendChild(info);
      row.appendChild(actions);

      list.appendChild(row);
    });

    if(summary){

      summary.textContent=
        this.files.length +
        (this.files.length===1
          ? " PDF"
          : " PDFs") +
        " • " +
        this.formatBytes(total);
    }
  }
};


