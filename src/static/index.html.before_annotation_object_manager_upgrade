<script id="professional-batch-center-js">

(function(){

    const state = {
        files: [],
        running: false
    };

    function $(id){
        return document.getElementById(id);
    }

    function open(){
        $("pp5BatchCenter").classList.remove("hidden");
        updateOperationUI();
    }

    function close(){

        if(state.running){
            return;
        }

        $("pp5BatchCenter").classList.add("hidden");
    }

    function addMore(){
        $("pp5Input").click();
    }

    function formatBytes(bytes){

        if(bytes < 1024){
            return bytes + " B";
        }

        if(bytes < 1024 * 1024){
            return (bytes / 1024).toFixed(1) + " KB";
        }

        return (
            bytes /
            (1024 * 1024)
        ).toFixed(1) + " MB";
    }

    function duplicateKey(file){

        return [
            file.name.toLowerCase(),
            file.size,
            file.lastModified
        ].join("|");

    }

    function addFiles(fileList){

        if(state.running){
            return;
        }

        const incoming = [
            ...fileList
        ];

        let added = 0;

        incoming.forEach(function(file){

            if(
                !file.name
                    .toLowerCase()
                    .endsWith(".pdf")
            ){
                return;
            }

            const key = duplicateKey(file);

            const duplicate =
                state.files.some(
                    f => duplicateKey(f) === key
                );

            if(duplicate){
                return;
            }

            if(state.files.length >= 100){
                return;
            }

            state.files.push(file);

            added++;

        });

        render();

    }

    function remove(index){

        if(state.running){
            return;
        }

        state.files.splice(index,1);

        render();

    }

    function clear(){

        if(state.running){
            return;
        }

        state.files = [];

        render();

    }

    function render(){

        const container = $("pp5Items");

        container.innerHTML = "";

        if(!state.files.length){

            container.innerHTML = `
                <div class="pp5-empty">
                    Add PDF files to begin.
                </div>
            `;

        }else{

            state.files.forEach(function(file,index){

                const item =
                    document.createElement("div");

                item.className = "pp5-item";

                item.innerHTML = `

                    <div class="pp5-index">
                        ${index + 1}
                    </div>

                    <div class="pp5-pdf-icon">
                        &#128196;
                    </div>

                    <div class="pp5-name">

                        <strong>
                            ${escapeHtml(file.name)}
                        </strong>

                        <span>
                            ${formatBytes(file.size)}
                        </span>

                    </div>

                    <div class="pp5-status">
                        Ready
                    </div>

                    <button
                        type="button"
                        class="pp5-remove"
                        onclick="PP5Batch.remove(${index})"
                        aria-label="Remove PDF"
                    >
                        &#10005;
                    </button>

                `;

                container.appendChild(item);

            });

        }

        $("pp5QueueCount").textContent =
            state.files.length +
            (state.files.length === 1 ? " PDF" : " PDFs");

        $("pp5Run").disabled =
            state.files.length === 0 ||
            state.running;

    }

    function escapeHtml(value){

        return String(value)
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");

    }

    function updateOperationUI(){

        const operation =
            $("pp5Operation").value;

        const needsPages =
            operation !== "compress";

        const needsDegrees =
            operation === "rotate";

        $("pp5PagesControl")
            .classList.toggle(
                "show",
                needsPages
            );

        $("pp5DegreesControl")
            .classList.toggle(
                "show",
                needsDegrees
            );

    }

    async function run(){

        if(state.running){
            return;
        }

        if(!state.files.length){
            return;
        }

        const operation =
            $("pp5Operation").value;

        const pages =
            $("pp5Pages").value.trim();

        const degrees =
            $("pp5Degrees").value;

        if(
            operation !== "compress" &&
            !pages
        ){

            alert(
                "Enter the page selection/order first."
            );

            return;
        }

        state.running = true;

        const runButton =
            $("pp5Run");

        runButton.disabled = true;

        $("pp5ProgressWrap")
            .classList.add("show");

        $("pp5ProgressText")
            .textContent =
                "Uploading " +
                state.files.length +
                " PDFs...";

        $("pp5ProgressBar")
            .style.width = "12%";

        const fd = new FormData();

        state.files.forEach(function(file){
            fd.append("files",file);
        });

        fd.append(
            "operation",
            operation
        );

        fd.append(
            "pages",
            pages
        );

        fd.append(
            "degrees",
            degrees
        );

        try{

            $("pp5ProgressText")
                .textContent =
                    "Processing batch...";

            $("pp5ProgressBar")
                .style.width = "48%";

            const response =
                await fetch(
                    "/api/batch-process",
                    {
                        method:"POST",
                        body:fd
                    }
                );

            if(!response.ok){

                let message =
                    "Batch processing failed.";

                try{

                    const error =
                        await response.json();

                    if(error.detail){
                        message =
                            error.detail;
                    }

                }catch(_){}

                throw new Error(message);

            }

            $("pp5ProgressText")
                .textContent =
                    "Preparing ZIP download...";

            $("pp5ProgressBar")
                .style.width = "85%";

            const blob =
                await response.blob();

            const url =
                URL.createObjectURL(blob);

            const a =
                document.createElement("a");

            a.href = url;

            a.download =
                "PrivatePDF_Batch_Results.zip";

            document.body.appendChild(a);

            a.click();

            a.remove();

            setTimeout(function(){
                URL.revokeObjectURL(url);
            },1500);

            $("pp5ProgressBar")
                .style.width = "100%";

            $("pp5ProgressText")
                .textContent =
                    "Batch complete. ZIP downloaded.";

        }catch(error){

            $("pp5ProgressBar")
                .style.width = "0%";

            $("pp5ProgressText")
                .textContent =
                    error.message ||
                    "Batch processing failed.";

        }finally{

            state.running = false;

            $("pp5Run").disabled =
                state.files.length === 0;

        }

    }

    const input =
        $("pp5Input");

    input.addEventListener(
        "change",
        function(){
            addFiles(this.files);
            this.value = "";
        }
    );

    const drop =
        $("pp5Drop");

    [
        "dragenter",
        "dragover"
    ].forEach(function(eventName){

        drop.addEventListener(
            eventName,
            function(event){

                event.preventDefault();
                event.stopPropagation();

                drop.classList.add("dragging");

            }
        );

    });

    [
        "dragleave",
        "drop"
    ].forEach(function(eventName){

        drop.addEventListener(
            eventName,
            function(event){

                event.preventDefault();
                event.stopPropagation();

                drop.classList.remove("dragging");

            }
        );

    });

    drop.addEventListener(
        "drop",
        function(event){

            addFiles(
                event.dataTransfer.files
            );

        }
    );

    $("pp5Operation").addEventListener(
        "change",
        updateOperationUI
    );

    window.PP5Batch = {
        open,
        close,
        addMore,
        addFiles,
        remove,
        clear,
        run,
        render
    };

    function installLauncher(){

        const organize =
            document.getElementById("organize");

        if(!organize){
            return;
        }

        if(
            document.getElementById(
                "pp5LaunchBatchCenter"
            )
        ){
            return;
        }

        const existing =
            document.getElementById(
                "pp4LaunchVisualManager"
            );

        const wrap =
            document.createElement("div");

        wrap.className =
            "pp5-launch-wrap";

        wrap.id =
            "pp5LaunchBatchCenter";

        wrap.innerHTML = `
            <button
                type="button"
                class="pp5-launch"
                onclick="PP5Batch.open()"
            >
                &#9889; Professional Batch Processing
                <span style="opacity:.72">
                    &nbsp; Multiple PDFs &bull; One ZIP
                </span>
            </button>
        `;

        if(existing){
            existing.insertAdjacentElement(
                "afterend",
                wrap
            );
        }else{
            const heading =
                organize.querySelector("h2");

            if(heading){
                heading.insertAdjacentElement(
                    "afterend",
                    wrap
                );
            }
        }

    }

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            installLauncher
        );

    }else{

        installLauncher();

    }

    render();

})();

</script>


<script id="upgrade-6-global-search-theme-js">

(function(){

    const search =
        document.getElementById(
            "pp6GlobalSearch"
        );

    const clearButton =
        document.getElementById(
            "pp6SearchClear"
        );

    const hint =
        document.getElementById(
            "pp6SearchHint"
        );

    const results =
        document.getElementById(
            "pp6SearchResults"
        );

    const theme =
        document.getElementById(
            "pp6ThemeToggle"
        );

    if(!search || !theme){
        return;
    }

    function textOf(el){

        return (
            el.innerText ||
            el.textContent ||
            ""
        )
        .replace(/\s+/g," ")
        .trim();

    }

    function getSearchTargets(){

        const targets = [];

        document
            .querySelectorAll(
                ".card, .nav button"
            )
            .forEach(function(el){

                if(
                    el.closest("#pp6GlobalToolbar")
                ){
                    return;
                }

                const text =
                    textOf(el);

                if(text){
                    targets.push({
                        el:el,
                        text:text.toLowerCase(),
                        title:text
                    });
                }

            });

        return targets;

    }

    function getSectionName(el){

        const section =
            el.closest(".section");

        if(!section){
            return "PDF tools";
        }

        const heading =
            section.querySelector("h2");

        return heading
            ? textOf(heading)
            : "PDF tools";

    }

    function sectionHasVisibleMatch(section){

        if(!section){
            return true;
        }

        const cards =
            [
                ...section.querySelectorAll(".card")
            ];

        if(!cards.length){
            return !section.classList.contains(
                "pp6-search-hidden"
            );
        }

        return cards.some(
            card =>
                !card.classList.contains(
                    "pp6-search-hidden"
                )
        );

    }

    function clearFiltering(){

        document
            .querySelectorAll(
                ".pp6-search-hidden"
            )
            .forEach(function(el){
                el.classList.remove(
                    "pp6-search-hidden"
                );
            });

        document
            .querySelectorAll(
                ".pp6-search-match"
            )
            .forEach(function(el){
                el.classList.remove(
                    "pp6-search-match"
                );
            });

        document
            .querySelectorAll(
                ".pp6-search-count"
            )
            .forEach(function(el){
                el.remove();
            });

        results.classList.remove("show");
        results.innerHTML = "";

        clearButton.classList.remove("show");
        hint.style.display = "";

    }

    function performSearch(value){

        const query =
            value
                .trim()
                .toLowerCase();

        if(!query){

            clearFiltering();

            return;

        }

        clearButton.classList.add("show");
        hint.style.display = "none";

        const targets =
            getSearchTargets();

        const matches =
            targets.filter(
                item =>
                    item.text.includes(query)
            );

        targets.forEach(function(item){

            if(
                item.text.includes(query)
            ){

                item.el.classList.add(
                    "pp6-search-match"
                );

            }else{

                item.el.classList.add(
                    "pp6-search-hidden"
                );

            }

        });

        document
            .querySelectorAll(".section")
            .forEach(function(section){

                if(
                    !sectionHasVisibleMatch(section)
                ){

                    section.classList.add(
                        "pp6-search-hidden"
                    );

                }else{

                    section.classList.remove(
                        "pp6-search-hidden"
                    );

                }

            });

        renderResults(matches.slice(0,8));

        let counter =
            document.getElementById(
                "pp6SearchCount"
            );

        if(!counter){

            counter =
                document.createElement("div");

            counter.id =
                "pp6SearchCount";

            counter.className =
                "pp6-search-count";

            document.body.appendChild(counter);

        }

        counter.textContent =
            matches.length +
            (
                matches.length === 1
                    ? " tool found"
                    : " tools found"
            );

        counter.classList.add("show");

    }

    function renderResults(matches){

        results.innerHTML = "";

        if(!matches.length){

            results.innerHTML = `
                <div class="pp6-no-results">
                    No matching tools found
                </div>
            `;

            results.classList.add("show");

            return;

        }

        matches.forEach(function(item){

            const button =
                document.createElement("button");

            button.type = "button";
            button.className = "pp6-result";

            button.innerHTML = `
                <span class="pp6-result-icon">
                    &#9881;
                </span>

                <span>
                    <span class="pp6-result-name">
                        ${escapeHtml(item.title)}
                    </span>

                    <span class="pp6-result-section">
                        ${escapeHtml(
                            getSectionName(item.el)
                        )}
                    </span>
                </span>
            `;

            button.addEventListener(
                "click",
                function(){

                    item.el.scrollIntoView({
                        behavior:"smooth",
                        block:"center"
                    });

                    item.el.classList.add(
                        "pp6-search-match"
                    );

                    results.classList.remove(
                        "show"
                    );

                }
            );

            results.appendChild(button);

        });

        results.classList.add("show");

    }

    function escapeHtml(value){

        return String(value)
            .replace(/&/g,"&amp;")
            .replace(/</g,"&lt;")
            .replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;")
            .replace(/'/g,"&#039;");

    }

    function updateThemeIcon(){

        const dark =
            document.body.classList.contains(
                "pp6-dark"
            );

        theme.innerHTML =
            dark
                ? "&#9728;"
                : "&#127769;";

        theme.title =
            dark
                ? "Switch to light mode"
                : "Switch to dark mode";

    }

    function applyTheme(mode){

        const dark =
            mode === "dark";

        document.body.classList.toggle(
            "pp6-dark",
            dark
        );

        localStorage.setItem(
            "privatepdf-theme",
            dark ? "dark" : "light"
        );

        updateThemeIcon();

    }

    const savedTheme =
        localStorage.getItem(
            "privatepdf-theme"
        );

    if(savedTheme === "dark"){

        applyTheme("dark");

    }else if(savedTheme === "light"){

        applyTheme("light");

    }else{

        applyTheme(
            window.matchMedia &&
            window.matchMedia(
                "(prefers-color-scheme: dark)"
            ).matches
                ? "dark"
                : "light"
        );

    }

    search.addEventListener(
        "input",
        function(){

            performSearch(
                search.value
            );

        }
    );

    search.addEventListener(
        "keydown",
        function(event){

            if(event.key === "Escape"){

                search.value = "";
                performSearch("");

                search.blur();

            }

        }
    );

    clearButton.addEventListener(
        "click",
        function(){

            search.value = "";

            performSearch("");

            search.focus();

        }
    );

    theme.addEventListener(
        "click",
        function(){

            const dark =
                document.body.classList.contains(
                    "pp6-dark"
                );

            applyTheme(
                dark
                    ? "light"
                    : "dark"
            );

        }
    );

    document.addEventListener(
        "keydown",
        function(event){

            if(
                (event.ctrlKey || event.metaKey) &&
                event.key.toLowerCase() === "k"
            ){

                event.preventDefault();

                search.focus();
                search.select();

            }

        }
    );

    document.addEventListener(
        "click",
        function(event){

            if(
                !event.target.closest(".pp6-search")
            ){

                results.classList.remove(
                    "show"
                );

            }

        }
    );

    updateThemeIcon();

})();

</script>


