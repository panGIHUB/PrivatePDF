<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PrivatePDF Pro — Professional PDF Toolkit</title>
<style>
:root{--bg:#f4f6fb;--panel:#fff;--ink:#101828;--muted:#667085;--line:#e4e7ec;--brand:#635bff;--brand2:#4f46e5;--soft:#eef2ff;--ok:#027a48;--danger:#b42318;--shadow:0 12px 35px rgba(16,24,40,.08)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial}.app{display:flex;min-height:100vh}.sidebar{width:270px;background:#111827;color:#fff;padding:20px 13px;position:sticky;top:0;height:100vh;overflow:auto}.brand{font-weight:900;font-size:21px;padding:8px 10px 20px}.brand small{display:block;font-size:11px;color:#a5b4fc;margin-top:4px}.navgroup{margin:15px 0}.navtitle{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#98a2b3;padding:8px 12px}.nav button{display:block;width:100%;text-align:left;border:0;background:transparent;color:#d0d5dd;padding:10px 12px;border-radius:10px;cursor:pointer}.nav button:hover,.nav button.active{background:#1f2937;color:#fff}.main{flex:1;min-width:0}.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 32px;position:sticky;top:0;z-index:5}.badge{background:#ecfdf3;color:var(--ok);padding:7px 11px;border-radius:99px;font-size:12px;font-weight:800}.content{max-width:1280px;margin:auto;padding:32px}.hero{background:linear-gradient(135deg,#111827,#312e81);color:#fff;border-radius:24px;padding:36px;box-shadow:var(--shadow);display:flex;justify-content:space-between;gap:28px;align-items:center}.hero h1{font-size:40px;line-height:1.04;margin:0 0 12px}.hero p{color:#d1d5db;max-width:760px;margin:0}.shield{font-size:70px}.section{margin-top:30px}.section h2{margin:0 0 5px}.section>p{color:var(--muted);margin-top:0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:18px}.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:18px;box-shadow:0 3px 14px rgba(16,24,40,.04)}.card h3{margin:0 0 6px}.card p{color:var(--muted);font-size:13px;min-height:36px}.card input,.card select{width:100%;padding:10px 11px;border:1px solid #d0d5dd;border-radius:9px;margin:5px 0;background:#fff}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.label{font-size:11px;font-weight:800;color:#475467;margin:7px 0 2px;display:block}.range{display:grid;grid-template-columns:1fr 56px;gap:8px;align-items:center}.range input[type=range]{padding:0}.range output{font-size:12px;text-align:right;color:var(--muted)}.primary{background:var(--brand);color:#fff;border:0;padding:11px 14px;border-radius:10px;font-weight:800;cursor:pointer;width:100%;margin-top:8px}.primary:hover{background:var(--brand2)}.secondary{background:#fff;color:#344054;border:1px solid #d0d5dd}.drop{border:2px dashed #cbd5e1;border-radius:12px;padding:14px;text-align:center;color:var(--muted);margin:7px 0}.note{font-size:12px;color:var(--muted);margin-top:8px}.preview{border:1px solid var(--line);background:#f8fafc;border-radius:12px;min-height:92px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-top:9px}.wm-preview{font-weight:800;letter-spacing:.04em;transform:rotate(-35deg);opacity:.35;user-select:none}.privacy{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.privacy div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px}.privacy b{display:block;margin-bottom:5px}.privacy span{font-size:12px;color:var(--muted)}#status{position:fixed;right:24px;bottom:24px;background:#111827;color:#fff;padding:13px 17px;border-radius:12px;display:none;box-shadow:var(--shadow);z-index:10}.hidden{display:none}@media(max-width:850px){.sidebar{width:72px;padding:15px 8px}.brand{font-size:0}.brand:first-letter{font-size:22px}.brand small,.navtitle,.nav button span{display:none}.nav button{text-align:center}.content{padding:18px}.hero{padding:25px}.hero h1{font-size:31px}.privacy{grid-template-columns:1fr}.topbar{padding:0 18px}.row,.row3{grid-template-columns:1fr}}
</style></head>
<body><div class="app">
<aside class="sidebar"><div class="brand">🔒 PrivatePDF Pro<small>Professional PDF toolkit</small></div>
<div class="navgroup"><div class="navtitle">Organize</div><div class="nav"><button onclick="show('organize',this)">📚 <span>Merge / Split / Pages</span></button><button onclick="show('edit',this)">✏️ <span>Edit & Layout</span></button></div></div>
<div class="navgroup"><div class="navtitle">Optimize</div><div class="nav"><button onclick="show('optimize',this)">⚡ <span>Compress / Resize</span></button><button onclick="show('convert',this)">🔄 <span>Convert</span></button></div></div>
<div class="navgroup"><div class="navtitle">Security</div><div class="nav"><button onclick="show('security',this)">🛡️ <span>Protect / Unlock</span></button><button onclick="show('privacy',this)">🔐 <span>Privacy</span></button></div></div>
<div class="navgroup"><div class="navtitle">Advanced</div><div class="nav"><button onclick="show('advanced',this)">🧰 <span>Advanced tools</span></button></div></div></aside>
<section class="main"><header class="topbar"><strong id="title">Organize</strong><span class="badge">● Temporary processing only</span></header><main class="content">
<section class="hero"><div><h1>Powerful PDFs.<br>Private by design.</h1><p>Professional controls for everyday PDF work — with the same core tools you already have, now presented with a cleaner, more precise workflow.</p></div><div class="shield">🛡️</div></section>

<section id="organize" class="section"><h2>Organize PDFs</h2><p>Arrange pages exactly the way you need.</p><div class="grid">
<div class="card"><h3>Merge PDF</h3><p>Combine multiple PDFs in selected order.</p><div class="drop"><input id="mergeFiles" type="file" multiple accept=".pdf"></div><button class="primary" onclick="merge()">Merge PDFs</button></div>
<div class="card"><h3>Split / Extract</h3><p>Extract pages using ranges such as 1,3,5-8.</p><input id="pagesFile" type="file" accept=".pdf"><input id="pagesSpec" placeholder="Pages: 1,3,5-8"><button class="primary" onclick="pageOp('extract')">Extract Pages</button></div>
<div class="card"><h3>Delete Pages</h3><p>Remove selected pages from a new copy.</p><input id="delFile" type="file" accept=".pdf"><input id="delSpec" placeholder="Pages: 2,4-6"><button class="primary" onclick="pageOp2('delete')">Delete Pages</button></div>
<div class="card"><h3>Rearrange Pages</h3><p>Set an exact new page order.</p><input id="reorderFile" type="file" accept=".pdf"><input id="reorderSpec" placeholder="Order: 3,1,2,5,4"><button class="primary" onclick="pageOp3('reorder')">Reorder Pages</button></div>
</div></section>

<section id="edit" class="section"><h2>Edit & Layout</h2><p>Fine-tune page geometry, numbering and visual overlays.</p><div class="grid">
<div class="card"><h3>Rotate PDF</h3><p>Rotate every page in 90° increments.</p><input id="rotFile" type="file" accept=".pdf"><select id="degrees"><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select><button class="primary" onclick="rotate()">Rotate</button></div>
<div class="card"><h3>Resize Pages</h3><p>Fit pages to standard paper sizes.</p><input id="resizeFile" type="file" accept=".pdf"><div class="row"><select id="paper"><option>A4</option><option>A3</option><option>Letter</option><option>Legal</option></select><select id="orient"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></div><button class="primary" onclick="resizePDF()">Resize</button></div>
<div class="card"><h3>Crop Margins</h3><p>Trim equal margins from every page.</p><input id="cropFile" type="file" accept=".pdf"><input id="margin" type="number" value="20" min="0" max="300" placeholder="Margin in points"><button class="primary" onclick="crop()">Crop</button></div>
<div class="card"><h3>Page Numbers</h3><p>Add sequential page numbers.</p><input id="numFile" type="file" accept=".pdf"><input id="startNum" type="number" value="1" min="1"><button class="primary" onclick="numbers()">Add Page Numbers</button></div>

<div class="card"><h3>Watermark</h3><p>Word-style controls: size, opacity, color, angle, position, bold, outline and tiled mode.</p><input id="wmFile" type="file" accept=".pdf"><input id="wmText" placeholder="CONFIDENTIAL" value="CONFIDENTIAL">
<label class="label">Font size</label><div class="range"><input id="wmSize" type="range" min="8" max="160" value="42" oninput="$('wmSizeOut').value=this.value"><output id="wmSizeOut">42</output></div>
<label class="label">Opacity</label><div class="range"><input id="wmOpacity" type="range" min="5" max="100" value="25" oninput="$('wmOpacityOut').value=this.value+'%'"><output id="wmOpacityOut">25%</output></div>
<div class="row"><div><label class="label">Color</label><input id="wmColor" type="color" value="#777777"></div><div><label class="label">Angle</label><input id="wmAngle" type="number" value="45" min="0" max="359"></div></div>
<label class="label">Position</label><select id="wmPosition"><option value="top-left">Top left</option><option value="top-center">Top center</option><option value="top-right">Top right</option><option value="center-left">Center left</option><option value="center" selected>Center</option><option value="center-right">Center right</option><option value="bottom-left">Bottom left</option><option value="bottom-center">Bottom center</option><option value="bottom-right">Bottom right</option></select>
<div class="row3"><label><input id="wmTiled" type="checkbox"> Tiled</label><label><input id="wmBold" type="checkbox"> Bold</label><label><input id="wmOutline" type="checkbox"> Outline</label></div>
<div class="preview"><div id="wmPreview" class="wm-preview">CONFIDENTIAL</div></div><button class="primary" onclick="watermark()">Add Watermark</button></div>
</div></section>

<section id="optimize" class="section"><h2>Optimize</h2><p>Reduce size or prepare documents for printing.</p><div class="grid">
<div class="card"><h3>Compress PDF</h3><p>Choose a size/quality profile.</p><input id="compFile" type="file" accept=".pdf"><select id="dpi"><option value="80">Small — 80 DPI</option><option value="110" selected>Balanced — 110 DPI</option><option value="160">Quality — 160 DPI</option></select><label class="label">JPEG quality</label><input id="quality" type="range" min="25" max="95" value="70" oninput="$('qualityOut').value=this.value"><div class="note">Quality: <output id="qualityOut">70</output></div><button class="primary" onclick="compress()">Compress PDF</button></div>
<div class="card"><h3>Grayscale PDF</h3><p>Create a print-friendly grayscale copy.</p><input id="grayFile" type="file" accept=".pdf"><button class="primary" onclick="simpleFile('/api/grayscale','grayFile','Grayscale.pdf')">Convert to Grayscale</button></div>
<div class="card"><h3>Metadata Cleaner</h3><p>Remove common PDF metadata.</p><input id="metaFile" type="file" accept=".pdf"><button class="primary" onclick="metadata()">Remove Metadata</button></div>
</div></section>

<section id="convert" class="section"><h2>Convert</h2><p>Keep conversions local where the required engine is installed.</p><div class="grid">
<div class="card"><h3>PDF → JPG</h3><p>Convert all pages to JPG images in a ZIP.</p><input id="jpgFile" type="file" accept=".pdf"><button class="primary" onclick="simpleFile('/api/pdf-to-jpg','jpgFile','PDF_Images.zip')">Convert</button></div>
<div class="card"><h3>Images → PDF</h3><p>Combine JPG/PNG images into a PDF.</p><input id="imgFiles" type="file" multiple accept="image/jpeg,image/png"><button class="primary" onclick="imagesPDF()">Create PDF</button></div>
<div class="card"><h3>PDF → Text</h3><p>Extract selectable text.</p><input id="txtFile" type="file" accept=".pdf"><button class="primary" onclick="simpleFile('/api/text','txtFile','Extracted_Text.txt')">Extract Text</button></div>
<div class="card"><h3>PDF → Markdown</h3><p>Turn page text into Markdown.</p><input id="mdFile" type="file" accept=".pdf"><button class="primary" onclick="simpleFile('/api/markdown','mdFile','Document.md')">Export Markdown</button></div>
<div class="card"><h3>Word / Excel / PPT → PDF</h3><p>Uses LibreOffice when installed.</p><input id="officeFile" type="file" accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp"><button class="primary" onclick="officePDF()">Convert to PDF</button><div class="note">Requires LibreOffice.</div></div>
<div class="card"><h3>PDF → Word / Excel / PPT</h3><p>Experimental conversion through LibreOffice.</p><input id="pdfOffice" type="file" accept=".pdf"><select id="officeKind"><option value="docx">Word (.docx)</option><option value="xlsx">Excel (.xlsx)</option><option value="pptx">PowerPoint (.pptx)</option></select><button class="primary" onclick="pdfOffice()">Convert</button></div>
</div></section>

<section id="security" class="section"><h2>Security</h2><p>Basic document protection and authorized decryption.</p><div class="grid">
<div class="card"><h3>Password Protect</h3><p>Encrypt a PDF with a password.</p><input id="protectFile" type="file" accept=".pdf"><input id="protectPass" type="password" placeholder="Password"><button class="primary" onclick="protect()">Protect PDF</button></div>
<div class="card"><h3>Unlock PDF</h3><p>Decrypt only when you know the password and are authorized.</p><input id="unlockFile" type="file" accept=".pdf"><input id="unlockPass" type="password" placeholder="Known password"><button class="primary" onclick="unlock()">Unlock PDF</button></div></div></section>

<section id="advanced" class="section"><h2>Advanced</h2><p>Operational checks and product architecture information.</p><div class="grid"><div class="card"><h3>Health Check</h3><p>Verify that the API is responding.</p><button class="primary" onclick="health()">Run Health Check</button></div><div class="card"><h3>Feature Test</h3><p>Run the bundled automated backend smoke test from your terminal.</p><div class="note">Command: <b>python test_all_features.py</b></div></div></div></section>
<section id="privacy" class="section"><h2>Privacy Architecture</h2><div class="privacy"><div><b>🚫 No document database</b><span>No persistent document database is used by this build.</span></div><div><b>⏱️ Temporary jobs</b><span>Files are processed in temporary job directories and cleaned on startup.</span></div><div><b>🔒 Minimal collection</b><span>No accounts, tracking profiles or document indexes are created by this starter.</span></div></div><p class="note">For a future public deployment, the exact retention/deletion policy should be enforced technically and stated clearly.</p></section>
</main></section></div><div id="status"></div>
<script>
const $=id=>document.getElementById(id);function show(id,btn){document.querySelectorAll('.section').forEach(x=>x.style.display='none');$(id).style.display='block';$('title').textContent=id[0].toUpperCase()+id.slice(1);document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}
function st(x){const s=$('status');s.textContent=x;s.style.display='block';clearTimeout(window.__st);window.__st=setTimeout(()=>s.style.display='none',3500)}
async function send(url,fd,name){st('Processing…');try{const r=await fetch(url,{method:'POST',body:fd});if(!r.ok){let t=await r.text();throw new Error(t)}const blob=await r.blob();const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);st('Done — downloaded')}catch(e){st('Error: '+e.message)}}
function one(id){return $(id).files[0]}function simpleFile(url,id,name){const f=one(id);if(!f)return st('Select a file');let fd=new FormData();fd.append('file',f);send(url,fd,name)}
function merge(){const fs=[...$('mergeFiles').files];if(!fs.length)return st('Select PDFs');let fd=new FormData();fs.forEach(f=>fd.append('files',f));send('/api/merge',fd,'Merged.pdf')}
function pageSend(fileId,specId,action){const f=one(fileId),p=$(specId).value;if(!f||!p)return st('Select PDF and pages');let fd=new FormData();fd.append('file',f);fd.append('pages',p);fd.append('action',action);send('/api/pages',fd,'Pages_Result.pdf')}function pageOp(a){pageSend('pagesFile','pagesSpec',a)}function pageOp2(a){pageSend('delFile','delSpec',a)}function pageOp3(a){pageSend('reorderFile','reorderSpec',a)}
function rotate(){let f=one('rotFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('degrees',$('degrees').value);send('/api/rotate',fd,'Rotated.pdf')}
function resizePDF(){let f=one('resizeFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('size',$('paper').value);fd.append('orientation',$('orient').value);send('/api/resize',fd,'Resized.pdf')}
function crop(){let f=one('cropFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('margin',$('margin').value);send('/api/crop',fd,'Cropped.pdf')}
function numbers(){let f=one('numFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('start',$('startNum').value);send('/api/numbers',fd,'Numbered.pdf')}
function watermark(){let f=one('wmFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('text',$('wmText').value);fd.append('size',$('wmSize').value);fd.append('opacity',Number($('wmOpacity').value)/100);fd.append('angle',$('wmAngle').value);fd.append('color',$('wmColor').value);fd.append('position',$('wmPosition').value);fd.append('tiled',$('wmTiled').checked);fd.append('bold',$('wmBold').checked);fd.append('outline',$('wmOutline').checked);send('/api/watermark',fd,'Watermarked.pdf')}
function compress(){let f=one('compFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('dpi',$('dpi').value);fd.append('quality',$('quality').value);send('/api/compress',fd,'Compressed.pdf')}
function metadata(){simpleFile('/api/metadata','metaFile','Metadata_Result.pdf')}function protect(){let f=one('protectFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('password',$('protectPass').value);send('/api/protect',fd,'Protected.pdf')}function unlock(){let f=one('unlockFile');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('password',$('unlockPass').value);send('/api/unlock',fd,'Unlocked.pdf')}
function imagesPDF(){let fs=[...$('imgFiles').files];if(!fs.length)return st('Select images');let fd=new FormData();fs.forEach(f=>fd.append('files',f));send('/api/images-to-pdf',fd,'Images_to_PDF.pdf')}function officePDF(){simpleFile('/api/office-to-pdf','officeFile','Converted.pdf')}function pdfOffice(){let f=one('pdfOffice');if(!f)return st('Select PDF');let fd=new FormData();fd.append('file',f);fd.append('kind',$('officeKind').value);send('/api/pdf-to-office',fd,'Converted_Office_File')}
async function health(){try{const r=await fetch('/api/health');const j=await r.json();st(j.ok?'API healthy':'API error')}catch(e){st('API unreachable')}}
function previewWM(){const p=$('wmPreview');p.textContent=$('wmText').value||'CONFIDENTIAL';p.style.fontSize=Math.min(42,Math.max(12,Number($('wmSize').value)/2))+'px';p.style.opacity=Number($('wmOpacity').value)/100;p.style.color=$('wmColor').value;p.style.transform='rotate('+(-Number($('wmAngle').value))+'deg)';p.style.fontWeight=$('wmBold').checked?'800':'600'}['wmText','wmSize','wmOpacity','wmColor','wmAngle','wmBold'].forEach(id=>$(id).addEventListener('input',previewWM));previewWM();show('organize');
</script></body></html>
